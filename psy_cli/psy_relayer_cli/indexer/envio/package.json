{
  "name": "psy-relayer-envio",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "python3 scripts/patch-history-backfill.py",
    "test": "node --test tests/*.test.cjs",
    "dev": "envio dev --config ./config.yaml",
    "codegen": "python3 scripts/patch-history-backfill.py && envio codegen --config ./config.yaml && python3 scripts/patch-history-backfill.py",
    "start": "python3 scripts/patch-history-backfill.py --check && envio start --config ./config.yaml"
  },
  "devDependencies": {
    "envio": "2.32.10",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@envio-dev/hypersync-client": "1.3.0",
    "poseidon-goldilocks-lite": "^0.2.3"
  }
}
