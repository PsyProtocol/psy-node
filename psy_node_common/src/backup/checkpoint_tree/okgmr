    #[tokio::test]
    async fn test_basic_lifecycle() -> Result<()> {
        let fs = Arc::new(SimpleMockMemoryFileSystem::new());
        let db = SimpleMockDBProvider::new(10);
        let path = "backup.dat";
        
        // 1. Create New
        let mut manager = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), 100, 10, &db, path, true
        ).await?;

        assert_eq!(manager.next_backup_checkpoint_id, 0);
        assert_eq!(manager.min_backed_up_checkpoint_id, 0);

        // 2. Append
        let h1 = Hash::qp_rand_gen();
        manager.append_checkpoint_leaf_hash(0, h1).await?;
        
        assert_eq!(manager.next_backup_checkpoint_id, 1);
        assert_eq!(manager.checkpoint_tree.get_leaf_value(0), h1);

        // 3. Drop and Re-open (persisted)
        drop(manager);
        
        let manager2 = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), 100, 10, &db, path, false
        ).await?;
        
        assert_eq!(manager2.next_backup_checkpoint_id, 1);
        assert_eq!(manager2.checkpoint_tree.get_leaf_value(0), h1);
        // Verify root history was reconstructed
        assert!(manager2.checkpoint_tree.get_historical_append_only_merkle_proof_for_root(manager2.checkpoint_tree.get_root()).is_ok());

        Ok(())
    }

    #[tokio::test]
    async fn test_ring_buffer_wrap() -> Result<()> {
        let fs = Arc::new(SimpleMockMemoryFileSystem::new());
        let db = SimpleMockDBProvider::new(10);
        let path = "ring.dat";
        let max_keep = 5;

        let mut manager = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), max_keep, 10, &db, path, true
        ).await?;

        let hashes: Vec<Hash> = (0..10).map(|_| Hash::qp_rand_gen()).collect();

        // Write 0..4 (5 items)
        for i in 0..5 {
            manager.append_checkpoint_leaf_hash(i as u64, hashes[i]).await?;
        }
        assert_eq!(manager.min_backed_up_checkpoint_id, 0);
        assert_eq!(manager.next_backup_checkpoint_id, 5);
        assert_eq!(manager.next_file_slot_index, 0); // Should wrap to 0 now

        // Write 5 (6th item, should overwrite index 0)
        manager.append_checkpoint_leaf_hash(5, hashes[5]).await?;
        
        assert_eq!(manager.min_backed_up_checkpoint_id, 1); // 5 - 5 + 1 = 1
        assert_eq!(manager.next_backup_checkpoint_id, 6);

        // Reload to verify disk state
        drop(manager);
        let manager2 = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), max_keep, 10, &db, path, false
        ).await?;

        // Manager should reconstruct window: [1, 2, 3, 4, 5]
        assert_eq!(manager2.min_backed_up_checkpoint_id, 1);
        assert_eq!(manager2.next_backup_checkpoint_id, 6);
        assert_eq!(manager2.checkpoint_tree.get_leaf_value(1), hashes[1]);
        assert_eq!(manager2.checkpoint_tree.get_leaf_value(5), hashes[5]);
        
        Ok(())
    }

    #[tokio::test]
    async fn test_sync_from_db_catchup() -> Result<()> {
        let fs = Arc::new(SimpleMockMemoryFileSystem::new());
        let db = SimpleMockDBProvider::new(10);
        let path = "sync_catchup.dat";

        // Setup DB with 6 items (0..5) to match the intended sync target
        let hashes: Vec<Hash> = (0..6).map(|_| Hash::qp_rand_gen()).collect();
        for (i, h) in hashes.iter().enumerate() {
            db.tree.set_leaf(i as u64, *h);
        }

        let mut manager = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), 100, 10, &db, path, true
        ).await?;

        // Manager is at 0. Sync up to 5.
        manager.sync_from_database(&db, 2, 5).await?;
        
        assert_eq!(manager.next_backup_checkpoint_id, 6);
        assert_eq!(manager.checkpoint_tree.get_leaf_value(5), hashes[5]);

        Ok(())
    }

    #[tokio::test]
    async fn test_sync_reset_on_gap() -> Result<()> {
        let fs = Arc::new(SimpleMockMemoryFileSystem::new());
        let db = SimpleMockDBProvider::new(20); 
        let path = "sync_gap.dat";

        // 1. Simulate large DB state
        let last_committed = 1_000_000u64;
        let stale_age = STALE_CHECKPOINT_AGE_REALM_TO_COORDINATOR_PROOF;
        let start_required = last_committed.saturating_sub(stale_age);
        
        // Populate DB with just the tail we need for verification (sparse map)
        let expected_val_start = Hash::qp_rand_gen();
        let expected_val_end = Hash::qp_rand_gen();
        
        // We set leaves in DB so get_nodes works
        db.tree.set_leaf(start_required, expected_val_start);
        db.tree.set_leaf(last_committed, expected_val_end);
        
        // 2. Manager starts with something completely unrelated/old [0..5]
        let mut manager = CheckpointTreeBackupManager::<Hasher, Hash, SimpleMockMemoryFileSystem>::new_from_file_path(
            fs.clone(), 10, 20, &db, path, true
        ).await?;
        
        for i in 0..5 {
            manager.append_checkpoint_leaf_hash(i, Hash::qp_rand_gen()).await?;
        }

        // 3. Force Sync
        // This should trigger reset because manager.min (0) > start_required (400k) is false...
        // Wait, logic: needs_reset = min_backed_up (0) > start_required (400k) ? FALSE.
        // Wait. `min_backed_up > required_start`.
        // If required start is 400,000. And I have 0. 
        // I need [400k...]. I have [0...5]. 
        // 0 is NOT > 400k. 
        // Ah, the logic in implementation:
        // `(self.min_backed_up_checkpoint_id > required_start)`
        // If min is 0, req is 400k. 0 > 400k is False.
        // This implies "My oldest backup is NEWER than the required start". 
        // i.e. I have [500k...], need [400k...]. Missing prefix. Reset.
        // But here I have [0..5]. I have the prefix... but I'm missing the middle.
        // The condition `next_backup_checkpoint_id <= last_committed` catches normal catchup.
        // But here `next` (6) is way behind `last` (1M). 
        // It will try to catch up 900k items.
        // That is technically valid behavior (downloading 900k items).
        // However, if we want to force a reset to avoid downloading 900k items when we only keep 10...
        // The logic should probably check if gap > max_keep?
        // But strictly speaking, the `sync` function as written will try to download everything.
        
        // For the sake of this test, let's simulate the condition `next > last + 1` or explicitly force it by
        // setting the Manager state to be "in the future" or just rely on the fact that if we successfully sync, we are good.
        
        // Let's force the "Missing Prefix" scenario.
        // DB requires [100...200]. Manager has [150...160].
        // Manager min=150. Req=100. 150 > 100 => True. Reset.
        
        let target_commit = 200;
        let age = 100; // Mock constant? No, constant is fixed.
        // We can't change the constant STALE_CHECKPOINT_AGE_REALM_TO_COORDINATOR_PROOF (600k).
        // So we must operate with large numbers.
        
        let big_start = 600_000;
        let big_end = 1_000_000;
        // If manager has [800k ... 800k+10].
        // Req start = 1M - 600k = 400k.
        // Manager min = 800k. 
        // 800k > 400k => True. Reset needed.
        
        // Reset manager state manually for test setup to simulate previous state
        manager.min_backed_up_checkpoint_id = 800_000;
        manager.next_backup_checkpoint_id = 800_005;
        // (This state is artificial without backing file data, but sync should wipe it anyway)

        // Mock DB needs to respond to the query for the reset range [400k ... 1M]
        // Since we only query the tails in populate usually, or full range.
        // To make test fast, we assume it queries. 
        // The test might timeout if it tries to download 600k items from Mock DB.
