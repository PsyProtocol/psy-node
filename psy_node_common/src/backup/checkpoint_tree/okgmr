// Import the specific Dash Tree implementation from your project

const CHECKPOINT_BACKUP_MAGIC_LEN: usize = 8;
const CHECKPOINT_BACKUP_MAGIC_BYTES: [u8; 8] = [0x50, 0x73, 0x79, 0x43, 0x68, 0x6B, 0x70, 0x74]; // "PsyChkpt"
const CHECKPOINT_BACKUP_MAGIC_U64_LE: u64 = 0x74_70_6B_68_43_79_73_50;
const CHECKPOINT_BACKUP_ITEM_SIZE: usize = 8 + 32; // u64 id + 32 bytes hash

pub struct CheckpointTreeBackupManager<
    Hasher: MerkleZeroHasher<Hash>,
    Hash: Eq + Copy + PartialEq + Default + std::hash::Hash,
    FileSystem: TokioLikeFileSystem,
> {
    pub checkpoint_tree: Arc<PsyDashMemoryAppendOnlyMerkleStore<Hasher, Hash>>,
    
    /// The maximum number of checkpoints to store in the ring buffer file.
    pub max_checkpoints_to_keep: u64,
    
    /// The lowest checkpoint ID currently in the tree/file (inclusive).
    pub min_backed_up_checkpoint_id: u64,
    
    /// The next checkpoint ID we expect to append.
    pub next_backup_checkpoint_id: u64,
    
    /// The index in the ring buffer file (0..max_checkpoints) where the NEXT write will go.
    pub next_file_slot_index: u64,
    
    pub backup_file_path: String,
    pub backup_file: FileSystem::File,
    pub file_system: Arc<FileSystem>,
}

impl<
    Hasher: MerkleZeroHasher<Hash> + Send + Sync + 'static, 
    Hash: Eq + Copy + PartialEq + Default + std::hash::Hash + Q256BitHash + Send + Sync + 'static, 
    FileSystem: TokioLikeFileSystem
> CheckpointTreeBackupManager<Hasher, Hash, FileSystem>
{
    /// Initialize from a file path.
    pub async fn new_from_file_path<CheckpointTreeStore: PsyNodeCheckpointTreeDatabaseReader<Hash>>(
        file_system: Arc<FileSystem>,
        max_checkpoints_to_keep: u64,
        checkpoint_tree_height: u8,
        checkpoint_tree_store: &CheckpointTreeStore,
        backup_file_path: &str,
        allow_create_file: bool,
    ) -> Result<Self> {
        let backup_file = if allow_create_file {
            file_system.file_like_fs_create(backup_file_path).await?
        } else {
            file_system.file_like_fs_open(backup_file_path).await?
        };

        Self::new_from_file(
            file_system,
            backup_file_path.to_string(),
            max_checkpoints_to_keep,
            checkpoint_tree_height,
            checkpoint_tree_store,
            backup_file,
            allow_create_file,
        )
        .await
    }

    /// Initialize from an open file handle.
    pub async fn new_from_file<CheckpointTreeStore: PsyNodeCheckpointTreeDatabaseReader<Hash>>(
        file_system: Arc<FileSystem>,
        backup_file_path: String,
        max_checkpoints_to_keep: u64,
        checkpoint_tree_height: u8,
        checkpoint_tree_store: &CheckpointTreeStore,
        mut backup_file: FileSystem::File,
        allow_create_file: bool,
    ) -> Result<Self> {
        // 1. Initialize or Validate File Header
        let file_len = backup_file.file_like_metadata().await?.len();
        
        if file_len == 0 {
            if !allow_create_file {
                anyhow::bail!("Backup file is empty and creation not allowed");
            }
            backup_file.write_u64_le(CHECKPOINT_BACKUP_MAGIC_U64_LE).await?;
            // Important: Flush header creation to FS
            file_system.file_like_fs_flush_file_with_path(&backup_file_path, &mut backup_file).await?;
        } else {
             if file_len < CHECKPOINT_BACKUP_MAGIC_LEN as u64 {
                anyhow::bail!("File too small for magic bytes");
             }
             backup_file.seek(std::io::SeekFrom::Start(0)).await?;
             let mut magic = [0u8; CHECKPOINT_BACKUP_MAGIC_LEN];
             backup_file.read_exact(&mut magic).await?;
             if magic != CHECKPOINT_BACKUP_MAGIC_BYTES {
                 anyhow::bail!("Invalid magic bytes");
             }
        }

        // 2. Load existing entries from the ring buffer
        // Note: We re-read file_len in case it changed or for clarity
        let file_len = backup_file.file_like_metadata().await?.len();
        let (mut leaf_nodes, _file_slot_count) = Self::load_raw_entries(&mut backup_file, file_len).await?;
        
        // Ensure strictly sorted by ID
        leaf_nodes.sort_by_key(|n| n.index);

        // 3. Find the contiguous chain ending at the highest ID (our robust recovery strategy)
        let valid_leaves = Self::get_contiguous_tail(&leaf_nodes);

        // 4. Determine state
        let (min_id, next_id, next_slot) = if let Some(last) = valid_leaves.last() {
            let first = valid_leaves.first().unwrap(); 
            // Calculate slot based on modulo arithmetic of the ID relative to max capacity
            let slot = (last.index + 1) % max_checkpoints_to_keep;
            (first.index, last.index + 1, slot)
        } else {
            (0, 0, 0)
        };

        let checkpoint_tree = Arc::new(PsyDashMemoryAppendOnlyMerkleStore::<Hasher, Hash>::new(checkpoint_tree_height));

        // 5. Hydrate the tree
        if !valid_leaves.is_empty() {
            // We use set_leaf to populate, but we MUST also populate the `roots` map 
            // so that historical lookups work.
            for leaf in valid_leaves {
                // set_leaf returns the proof containing the new root
                let proof = checkpoint_tree.set_leaf(leaf.index, leaf.value); 
                checkpoint_tree.roots.insert(proof.new_root, leaf.index);
            }
        }

        Ok(Self {
            checkpoint_tree,
            max_checkpoints_to_keep,
            min_backed_up_checkpoint_id: min_id,
            next_backup_checkpoint_id: next_id,
            next_file_slot_index: next_slot,
            backup_file_path,
            backup_file,
            file_system,
        })
    }

    /// Helper to read all valid entries from the file irrespective of order.
    async fn load_raw_entries(file: &mut FileSystem::File, file_len: u64) -> Result<(Vec<MerkleLeafNode<Hash>>, u64)> {
        if file_len <= CHECKPOINT_BACKUP_MAGIC_LEN as u64 {
            return Ok((vec![], 0));
        }

        let data_len = file_len - CHECKPOINT_BACKUP_MAGIC_LEN as u64;
        let count = data_len / CHECKPOINT_BACKUP_ITEM_SIZE as u64;
        let mut leaves = Vec::with_capacity(count as usize);

        file.seek(std::io::SeekFrom::Start(CHECKPOINT_BACKUP_MAGIC_LEN as u64)).await?;

        for _ in 0..count {
            let id = file.read_u64_le().await?;
            let mut hash_bytes = [0u8; 32];
            file.read_exact(&mut hash_bytes).await?;
            
            // Only add if it looks somewhat valid (unlikely to have 0 ID and 0 Hash unless it's genesis)
            // But we let the sort/contiguous logic handle gaps.
            let hash = Hash::from_ref_32bytes(&hash_bytes);
            leaves.push(MerkleLeafNode { index: id, value: hash });
        }

        Ok((leaves, count))
    }

    /// Logic to find the longest contiguous list of checkpoints ending at the highest found ID.
    fn get_contiguous_tail(sorted_nodes: &[MerkleLeafNode<Hash>]) -> Vec<MerkleLeafNode<Hash>> {
        if sorted_nodes.is_empty() {
            return vec![];
        }

        // We iterate backwards from the highest ID.
        let mut result = Vec::new();
        let mut expected_index = sorted_nodes.last().unwrap().index;

        for node in sorted_nodes.iter().rev() {
            if node.index == expected_index {
                result.push(node.clone());
                if expected_index == 0 { break; } // prevent underflow
                expected_index -= 1;
            } else if node.index > expected_index {
                continue; // duplicate or disorder
            } else {
                break; // gap detected
            }
        }
        result.reverse();
        result
    }

    /// Append a new checkpoint. strictly sequential.
    pub async fn append_checkpoint_leaf_hash(&mut self, checkpoint_id: u64, checkpoint_hash: Hash) -> Result<DeltaMerkleProofCore<Hash>> {
        // 1. Validation
        if checkpoint_id != self.next_backup_checkpoint_id {
            // Idempotency check: if we try to append what we just appended
            if checkpoint_id == self.next_backup_checkpoint_id.saturating_sub(1) {
                if self.checkpoint_tree.get_leaf_value(checkpoint_id) == checkpoint_hash {
                    tracing::info!("Skipping duplicate append for id {}", checkpoint_id);
                    return Ok(self.checkpoint_tree.set_leaf(checkpoint_id, checkpoint_hash));
                }
            }
            anyhow::bail!("Non-sequential append. Expected {}, got {}", self.next_backup_checkpoint_id, checkpoint_id);
        }

        // 2. Write to disk
        let write_pos = CHECKPOINT_BACKUP_MAGIC_LEN as u64 + (self.next_file_slot_index * CHECKPOINT_BACKUP_ITEM_SIZE as u64);
        self.backup_file.seek(std::io::SeekFrom::Start(write_pos)).await?;
        
        self.backup_file.write_u64_le(checkpoint_id).await?;
        self.backup_file.write_all(&checkpoint_hash.into_owned_32bytes()).await?;
        
        // CRITICAL: Flush to the FS abstraction. 
        // Some mocks (and real FS implementations) buffer writes in the File object until flushed to the FS map/disk.
        self.file_system.file_like_fs_flush_file_with_path(&self.backup_file_path, &mut self.backup_file).await?;
        
        // 3. Update State
        self.next_file_slot_index += 1;
        if self.next_file_slot_index >= self.max_checkpoints_to_keep {
            self.next_file_slot_index = 0; // Wrap around
        }
        
        self.next_backup_checkpoint_id += 1;
        
        // Update min_backed_up logic
        // If we have exceeded capacity, the window moves.
        if self.next_backup_checkpoint_id > self.max_checkpoints_to_keep {
            self.min_backed_up_checkpoint_id = self.next_backup_checkpoint_id - self.max_checkpoints_to_keep;
        }

        // 4. Update Memory Tree
        let proof = self.checkpoint_tree.append_leaf(checkpoint_id, checkpoint_hash)?;
        Ok(proof)
    }

    /// Syncs the backup manager with the database.
    pub async fn sync_from_database<CheckpointTreeReader: PsyNodeCheckpointTreeDatabaseReader<Hash>>(
        &mut self,
        checkpoint_tree_reader: &CheckpointTreeReader,
        sync_batch_size: usize,
        last_committed_checkpoint_id: u64,
    ) -> Result<()> {
        let required_start = last_committed_checkpoint_id.saturating_sub(STALE_CHECKPOINT_AGE_REALM_TO_COORDINATOR_PROOF);
        
        let needs_reset = 
            // If we are missing the prefix history required for stale proofs
            (self.min_backed_up_checkpoint_id > required_start) ||
            // Or disjoint/future state (shouldn't happen normally)
            (self.next_backup_checkpoint_id > last_committed_checkpoint_id + 1);

        if needs_reset {
            tracing::warn!("Backup Manager out of sync (Missing prefix or disjoint). Resetting and re-hydrating from DB.");
            self.reset_and_rehydrate(checkpoint_tree_reader, required_start, last_committed_checkpoint_id, sync_batch_size).await?;
        } else {
            // We have the start, just catch up
            if self.next_backup_checkpoint_id <= last_committed_checkpoint_id {
                let amount = (last_committed_checkpoint_id - self.next_backup_checkpoint_id) + 1;
                tracing::info!("Backup Manager catching up {} checkpoints from DB.", amount);
                self.populate_from_database(
                    checkpoint_tree_reader, 
                    sync_batch_size, 
                    self.next_backup_checkpoint_id, 
                    amount as usize
                ).await?;
            }
        }
        
        // Final verification
        let root = self.checkpoint_tree.get_root();
        let expected_root = checkpoint_tree_reader.checkpoint_tree_get_root_hash(last_committed_checkpoint_id).await?;
        if root != expected_root {
            anyhow::bail!("Sync failed: Root mismatch. Local: {:?}, DB: {:?}", root, expected_root);
        }

        Ok(())
    }

    async fn reset_and_rehydrate<CheckpointTreeReader: PsyNodeCheckpointTreeDatabaseReader<Hash>>(
        &mut self,
        reader: &CheckpointTreeReader,
        start_id: u64,
        end_id: u64,
        batch_size: usize
    ) -> Result<()> {
        // 1. Reset File
        //self.backup_file.set_len(CHECKPOINT_BACKUP_MAGIC_LEN as u64).await?;
        self.backup_file.seek(std::io::SeekFrom::Start(CHECKPOINT_BACKUP_MAGIC_LEN as u64)).await?;
        self.file_system.file_like_fs_flush_file_with_path(&self.backup_file_path, &mut self.backup_file).await?;
        
        // 2. Reset Counters
        self.next_backup_checkpoint_id = start_id;
        self.min_backed_up_checkpoint_id = start_id;
        self.next_file_slot_index = (start_id % self.max_checkpoints_to_keep);
        
        // 3. Populate
        let count = (end_id - start_id) + 1;
        self.populate_from_database(reader, batch_size, start_id, count as usize).await?;
        
        Ok(())
    }

    pub async fn populate_from_database<CheckpointTreeReader: PsyNodeCheckpointTreeDatabaseReader<Hash>>(
        &mut self,
        checkpoint_tree_reader: &CheckpointTreeReader,
        batch_size: usize,
        start_checkpoint_id: u64,
        count: usize,
    ) -> Result<()> {
        if count == 0 { return Ok(()); }
        
        let end_id = start_checkpoint_id + (count as u64) - 1;
        let mut current_start = start_checkpoint_id;

        while current_start <= end_id {
            let current_end = std::cmp::min(current_start + (batch_size as u64) - 1, end_id);
            
            let height = self.checkpoint_tree.get_height();
            let keys: Vec<SimpleMerkleNodeKey> = (current_start..=current_end)
                .map(|idx| SimpleMerkleNodeKey::new(height, idx))
                .collect();
            
            let values = checkpoint_tree_reader.checkpoint_tree_get_nodes(0, &keys).await?;
            
            if values.len() != keys.len() {
                anyhow::bail!("DB returned insufficient nodes");
            }

            for (i, val) in values.into_iter().enumerate() {
                let id = current_start + i as u64;
                self.append_checkpoint_leaf_hash(id, val).await?;
            }

            current_start = current_end + 1;
        }
        Ok(())
    }
}


