PARTH_PERF_DB=/var/lib/parth-performance-monitor/prove-proxy/metrics.sqlite3
PARTH_PERF_UNIT=parth-offsite-prove-proxy.service
PARTH_PERF_CGROUP=/sys/fs/cgroup/system.slice/parth-offsite-prove-proxy.service
PARTH_PERF_INTERVAL_SECS=5
PARTH_PERF_RETENTION_DAYS=30
PARTH_PERF_JOURNAL_ENABLED=1
PARTH_PERF_JOURNAL_INITIAL_SINCE="-1 hour"
PARTH_PERF_STORAGE_PATH=/
PARTH_PERF_ALERT_CONSECUTIVE_SAMPLES=3
PARTH_PERF_ALERT_COOLDOWN_SECS=900
PARTH_PERF_ALERT_MEMORY_GIB=56
PARTH_PERF_ALERT_AVAILABLE_GIB=4
PARTH_PERF_ALERT_SWAP_OUT_MIB_PER_MIN=64
PARTH_PERF_ALERT_MEMORY_PSI_AVG10=0.1
PARTH_PERF_ALERT_DISK_AVAILABLE_GIB=10
PARTH_PERF_ALERT_DISK_AVAILABLE_PERCENT=10
PARTH_PERF_ALERT_INODE_FREE_PERCENT=10
PARTH_PERF_ALERT_ZRAM_PERCENT=80
