# Copy to deploy/local-testnet/cloudflare-tunnel/local.env and edit locally.

# Root containing this checkout and sibling repositories.
WORKSPACE_HOME="${WORKSPACE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)}"

# Cloudflare named tunnel. Create it with:
#   cloudflared tunnel login
#   cloudflared tunnel create psy-local-staging
# Then either set LOCAL_CF_TUNNEL_ID to the UUID, or keep the tunnel name if
# your cloudflared installation resolves named tunnels from the cert.
LOCAL_CF_TUNNEL_NAME="psy-local-staging"
LOCAL_CF_TUNNEL_ID=""
LOCAL_CF_TUNNEL_CREDENTIALS_FILE=""
# Set to 0 only when you want to run deploy/local-testnet/cloudflare-tunnel/run-tunnel.sh
# yourself. The default starts cloudflared as part of up.sh.
LOCAL_CF_START_TUNNEL="1"

# DNS suffix for temporary local staging hostnames. These records must be in a
# Cloudflare zone available to the logged-in account.
LOCAL_CF_DOMAIN_SUFFIX="psy-protocol.xyz"

LOCAL_CF_APP_HOST="app-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_EXPLORER_HOST="explorer-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_IDE_HOST="ide-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_COORDINATOR_HOST="coordinator-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_REALM0_HOST="realm0-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_REALM1_HOST="realm1-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_PROVE_HOST="prove-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_FAUCET_HOST="faucet-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_SERVICES_HOST="services-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_INDEXER_HOST="indexer-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_L1_RPC_HOST="rpc-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_ETH_FAUCET_HOST="eth-faucet-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_NOSTR_HOST="nostr-local.${LOCAL_CF_DOMAIN_SUFFIX}"
LOCAL_CF_NOSTR_RELAY_URL="wss://${LOCAL_CF_NOSTR_HOST}/"

# Local ports from deploy/local-testnet/stack. Override only if stack/local.env
# uses non-default ports.
LOCAL_STAGING_COORDINATOR_EDGE_PORT="1337"
LOCAL_STAGING_REALM_EDGE_BASE_PORT="13380"
LOCAL_STAGING_REALM_EDGE_PORT_STRIDE="10"
LOCAL_STAGING_PROVE_PROXY_ADDR="127.0.0.1:9999"
LOCAL_STAGING_FAUCET_ADDR="127.0.0.1:9998"
LOCAL_STAGING_PSY_SERVICES_ADDR="127.0.0.1:3000"
LOCAL_STAGING_APP_PORT="8088"
LOCAL_STAGING_EXPLORER_PORT="8089"
LOCAL_STAGING_IDE_PORT="8090"
LOCAL_STAGING_L1_RPC_PORT="8545"
LOCAL_STAGING_L1_CHAIN_ID="31338"
# Mine local L1 blocks continuously so frontend confirmation counters advance.
# Set to 0 or empty to restore anvil's default automine-only behavior.
LOCAL_STAGING_L1_BLOCK_TIME="1"
LOCAL_STAGING_INDEXER_PORT="8080"
LOCAL_NOSTR_PORT="8081"
LOCAL_CF_ETH_FAUCET_PORT="8555"

# Frontend build controls passed through to deploy/local-testnet/stack/publish-frontends.sh.
LOCAL_STAGING_BUILD_FRONTENDS="1"
LOCAL_STAGING_NPM_INSTALL="0"
LOCAL_STAGING_BUILD_WALLET="0"
# PSY_WALLET_DIR="$WORKSPACE_HOME/psy-wallet"

# Frontend-only auto deploy. Deployment tools remain in this checkout while
# clean source checkouts below track the improve-relayer branches. No backend
# process is rebuilt or restarted.
LOCAL_CF_AUTODEPLOY_REMOTE="origin"
LOCAL_CF_AUTODEPLOY_ENABLED="1"
LOCAL_CF_AUTODEPLOY_BRANCH="feat/improve-bridge-relayer"
LOCAL_CF_AUTODEPLOY_WALLET_BRANCH="feat/improve-bridge-relayer"
LOCAL_CF_AUTODEPLOY_SDK_BRANCH="feat/improve-bridge-relayer"
# Defaults to a frontend-autodeploy directory next to this Parth checkout.
# LOCAL_CF_AUTODEPLOY_SOURCE_ROOT="$WORKSPACE_HOME/improve-relayer-latest-local-test/frontend-autodeploy"
LOCAL_CF_AUTODEPLOY_INTERVAL_SECONDS="120"
LOCAL_CF_AUTODEPLOY_ALLOW_DIRTY="0"
LOCAL_CF_AUTODEPLOY_BOOTSTRAP_OBSERVE_ONLY="1"
LOCAL_CF_AUTODEPLOY_RETRY_FAILED_AFTER_SECONDS="1800"
LOCAL_CF_AUTODEPLOY_REQUIRE_ABI_MATCH="1"
# The deployed backend ABI snapshot. Automatic frontend updates are held when
# the tracked branch changes these ABIs; backend deployment remains manual.
# Defaults to the immutable snapshot updated only after a successful intentional
# backend deployment. Do not point this at a source checkout's genesis_abi.
# LOCAL_CF_AUTODEPLOY_BACKEND_ABI_DIR="/path/to/live/psy-node/.local-staging/backend-abi/current"
# Set explicitly for a backend deployment that should promote a new snapshot.
# LOCAL_CF_UPDATE_BACKEND_ABI_SNAPSHOT="1"
LOCAL_CF_SDK_BUILD_ATTEMPTS="2"
LOCAL_CF_SDK_BUILD_RETRY_DELAY_SECONDS="10"
LOCAL_CF_FRONTEND_RELEASE_KEEP="5"

# Wallet packages should be published to R2, not served through the local
# Cloudflare tunnel. The bridge app reads this fixed metadata URL.
LOCAL_CF_WALLET_RELEASE_URL="https://wallet-assets-stg.psy-protocol.xyz/local-devnet/wallet-release.json"
LOCAL_CF_AUTODEPLOY_BUILD_WALLET="1"
LOCAL_CF_WALLET_PACKAGE_MODE="dev"
LOCAL_CF_WALLET_BUILD_COMMAND="pnpm build:dev"
LOCAL_CF_WALLET_R2_METADATA_KEY="local-devnet/wallet-release.json"
# PSY_WALLET_DIR="$WORKSPACE_HOME/psy-wallet"
# CF_ENV_FILE="$WORKSPACE_HOME/cf_env"
# R2_BUCKET="psy-wallet-assets-stg"
# R2_PUBLIC_BASE_URL="https://wallet-assets-stg.psy-protocol.xyz"
# R2_SKIP_UPLOAD="0"
# R2_SKIP_VERIFY="0"

# Start anvil automatically for rpc-local when local-staging does not already
# have a service on LOCAL_STAGING_L1_RPC_PORT.
LOCAL_CF_START_ANVIL="1"
# LOCAL_STAGING_ANVIL_BIN="/home/peter/.foundry/bin/anvil"

# Deploy psy-contracts to local Anvil when deployed-contracts.json is missing
# or points at addresses with no code on the current Anvil instance.
LOCAL_CF_DEPLOY_L1_CONTRACTS="1"
# LOCAL_STAGING_CONTRACTS_DIR="$WORKSPACE_HOME/pr-255-local-deploy/psy-contracts"
# Export Groth16 Solidity verifier sources from the local relayer setup before
# deploying localhost L1 contracts. Keep this enabled so the local verifier
# matches the runtime Groth16 setup.
LOCAL_CF_EXPORT_GROTH16_VERIFIERS="1"
# LOCAL_GROTH16_KEYSTORE_ROOT="$HOME/.psy/keystore"
# A reset regenerates the bridge, deposit_append, and withdrawal_claim setups
# when their circuit source hash changed. Set this to 1 to force regeneration.
# LOCAL_CF_REGENERATE_GROTH16_KEYSTORE="1"
# Override only when externally managed setup directories are intentionally
# kept outside LOCAL_GROTH16_KEYSTORE_ROOT.
# LOCAL_GROTH16_BRIDGE_KEYSTORE_DIR="$HOME/.psy/keystore"
# LOCAL_GROTH16_WITHDRAWAL_CLAIM_KEYSTORE_DIR="$HOME/.psy/keystore/withdrawal_claim"
# GROTH16_SETUP_KEYSTORE_ROOT="/path/to/dist/groth16-keystore"

# Localhost ETH faucet for coworkers. It tops any address up to this balance on
# the local Anvil chain using anvil_setBalance.
LOCAL_CF_START_ETH_FAUCET="1"
LOCAL_CF_ETH_FAUCET_BALANCE_ETH="10"

# Envio indexes derived L1 bridge events for tx-hash -> deposit proof metadata.
# Local Anvil is often restarted from genesis with the same chain id, so reset
# and re-scan Envio by default to avoid serving stale old-chain deposits after a
# reboot.
LOCAL_CF_START_ENVIO="1"
LOCAL_CF_RESET_ENVIO_ON_START="1"
LOCAL_CF_ENVIO_START_BLOCK="1"
LOCAL_CF_ENVIO_HASURA_ADMIN_SECRET="testing"

# Local bridge relayer. This is required for ETH -> Psy deposits and Psy -> ETH
# withdrawals to move between the local Anvil contracts and the local Psy chain.
LOCAL_CF_START_RELAYER="1"
LOCAL_STAGING_RELAYER_L2_KEY_INDEX="2"
LOCAL_STAGING_RELAYER_POLL_INTERVAL_SECS="5"
LOCAL_STAGING_RELAYER_CONFIRMATION_LAG_CHECKPOINTS="1"
# Bridge aggregation needs at least two checkpoints. Keep this finite for local
# chains that may start from an empty L1 StateManager after a reboot; 0 means
# "catch up everything in one proof", which makes the first local finalize stall
# after the Psy chain has already produced thousands of checkpoints.
LOCAL_STAGING_RELAYER_MAX_CHECKPOINT_BATCH="32"
# A retained local chain may need several hours to replay historical checkpoint
# batches after deploying a fresh L1 verifier or StateManager.
LOCAL_STAGING_RELAYER_READY_TIMEOUT_SECS="14400"
LOCAL_STAGING_RELAYER_SERVICES_EVENT_SETTLE_SECS="1"
LOCAL_STAGING_RELAYER_L1_PRIVATE_KEY="ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80"
