# Cloudflare tunnel settings for the prove-proxy role-split test.
# Tunnel psy-local-staging under psy-protocol.xyz (routes created 2026-06); the
# public prove-local host fronts the role=user pool, the relayer stays local.

# No frontend auto deploy: this environment is built once from pinned worktrees.
LOCAL_CF_AUTODEPLOY_ENABLED="0"

# Frontend sources. The release script requires each checkout to be clean and to
# sit exactly on origin/<branch>.
PSY_WALLET_DIR="/home/peter/git/bridge_zilong/psy-wallet-system-prove-proxy-url"
LOCAL_CF_WALLET_BRANCH="feat/system-prove-proxy-url"
PSY_SDK_DIR="/home/peter/git/bridge_zilong/psy-sdk-prove-proxy-test"
LOCAL_CF_SDK_BRANCH="mainnet-beta"
LOCAL_CF_AUTODEPLOY_BUILD_WALLET="1"
LOCAL_CF_AUTODEPLOY_BUILD_SDK="1"
LOCAL_CF_FRONTEND_RELEASE_KEEP="5"
LOCAL_CF_FRONTEND_SMOKE="1"
LOCAL_CF_FRONTEND_SMOKE_PUBLIC="1"

# Wallet R2 publishing (same staging bucket and local-devnet slot as before).
CF_ENV_FILE="/home/peter/git/bridge_zilong/cf_env"
LOCAL_CF_WALLET_RELEASE_URL="https://wallet-assets-stg.psy-protocol.xyz/local-devnet/wallet-release.json"
LOCAL_CF_WALLET_R2_METADATA_KEY="local-devnet/wallet-release.json"
LOCAL_CF_WALLET_PACKAGE_MODE="dev"
LOCAL_CF_WALLET_BUILD_COMMAND="pnpm build:dev"

# Envio gets its own compose project so the old parth-local-envio volumes stay.
LOCAL_CF_ENVIO_COMPOSE_PROJECT="psy-role-envio"

# Groth16 keystores for this runtime's bridge circuits live under the isolated
# proxy HOME (see stack/local.env). Missing files trigger regeneration on the
# first run; the source stamp then keeps them until the circuits change.
LOCAL_GROTH16_KEYSTORE_ROOT="/home/peter/.psy-role-home/.psy/keystore"

# psy-contracts (multi_chain pin) registers localhost, localhostBsc and
# localhostBase; localhostBsc defaults to 31338, the same id the stack gives
# anvil for localhost, and the registry rejects duplicates. Move it aside.
LOCALHOST_BSC_L1_CHAIN_ID="31340"
