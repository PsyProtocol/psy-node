# Local stack settings for the prove-proxy role-split test.
# Tools: this deploy worktree (branch deploy/prove-proxy-role).
# Runtime source: psy-node-prove-proxy-role (feat/prove-proxy-role-split), passed on
# the command line as LOCAL_STAGING_SOURCE_PARTH_DIR / LOCAL_CF_SOURCE_PARTH_DIR
# because both layers compute PARTH_DIR before they read this file.

# Keep the rollback testnet's Docker state (project parth-local-staging, prefix
# parth-local) untouched: this stack gets its own containers and volumes.
LOCAL_STAGING_COMPOSE_PROJECT="psy-role-staging"
LOCAL_STAGING_CONTAINER_PREFIX="psy-role"

# Two realms: faucet operators are generated across a two-realm user space.
LOCAL_STAGING_REALMS="0 1"

# Clean psy-services checkout at the sepolia profile pin (819d8d1e), built by the
# stack when LOCAL_STAGING_BUILD=1.
PSY_SERVICES_HOME="/home/peter/git/bridge_zilong/psy-services-prove-proxy-test"

# Prove-proxy pools: wallets on 9999 (role=user), relayer on 9997 (role=system).
LOCAL_STAGING_PROVE_PROXY_ADDR="127.0.0.1:9999"
LOCAL_STAGING_PROVE_PROXY_ROLE="user"
LOCAL_STAGING_START_SYSTEM_PROVE_PROXY="1"
LOCAL_STAGING_SYSTEM_PROVE_PROXY_ADDR="127.0.0.1:9997"

# Full stack for colleagues: frontends, nginx, indexers, psy-services all on.
LOCAL_STAGING_START_WORKERS="1"
LOCAL_STAGING_START_PSY_SERVICES="1"
LOCAL_STAGING_START_INDEXERS="1"
LOCAL_STAGING_START_PROVE_PROXY="1"
LOCAL_STAGING_START_FAUCET_SERVER="1"
LOCAL_STAGING_START_NGINX="1"
LOCAL_STAGING_PUBLISH_FRONTENDS="1"
LOCAL_STAGING_BUILD_FRONTENDS="1"
# First run: psy-dapp has no node_modules yet. Set back to 0 afterwards.
LOCAL_STAGING_NPM_INSTALL="1"

LOCAL_STAGING_ENABLE_PSY_FAUCET="1"
LOCAL_STAGING_PSY_FAUCET_REQUIRE_TURNSTILE="0"

# Ports: defaults (nostr 8081, indexer 8080, app 8088) once the unrelated
# services that used to hold 8080/8081 are moved.

# Isolated HOME for both prove-proxy processes: the system proxy reads its
# Groth16 keystores from $HOME/.psy/keystore, and this test regenerates them
# for the multi_chain bridge circuits without touching ~/.psy/keystore.
LOCAL_STAGING_PROVE_PROXY_HOME="/home/peter/.psy-role-home"

# Host port 6379 is held by the psy-services-valkey test container (Docker
# allocates it without a visible listener). Use another host port; the stack
# builds REDIS_URL from this value.
LOCAL_REDIS_PORT="16379"
