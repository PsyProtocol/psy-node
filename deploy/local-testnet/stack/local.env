# psy-node local testnet, migrated from parth-generic-v1/deploy/local-testnet.
#
# Narrowed to what a rollback verification needs: a Coordinator, one Realm,
# workers, and the funding path (L1 -> bridge -> faucet -> prove-proxy).
# Frontends, nginx, indexers and psy-services are off -- they serve the wallet
# and explorer, which no rollback assertion reads.

# Two Realms, not one.  The faucet operators are generated across the same
# two-realm user space staging uses, so a single-Realm deployment strands half
# of them: the faucet picked user 1310720, which is past one Realm's capacity
# (users_per_realm = 1048576) and lands in Realm 1, and startup failed with
# "realm id `1` not found".  Exercising slice B needs one Realm to commit, not
# for the other to be absent.
LOCAL_STAGING_REALMS="0 1"

LOCAL_STAGING_BUILD="1"
# The persisted volume from a previous deployment holds a different network:
# startup refused with "genesis checkpoint state transition hash mismatch at
# latest_checkpoint_id=109", which is the node correctly declining to adopt a
# chain whose genesis identity is not the one it was built with.  This machine
# is dedicated to this testnet, so the stale volume goes.
# The volume has been reset once; keeping it on would discard the chain on
# every run, and from here the point is to accumulate one.
LOCAL_STAGING_RESET="1"

# Ports: the machine is dedicated to this testnet, so the defaults stand.
LOCAL_STAGING_COORDINATOR_EDGE_PORT="1337"
LOCAL_STAGING_REALM_EDGE_BASE_PORT="13380"
LOCAL_STAGING_REALM_EDGE_PORT_STRIDE="10"
LOCAL_STAGING_PROVE_PROXY_ADDR="127.0.0.1:9999"
LOCAL_STAGING_FAUCET_ADDR="127.0.0.1:9998"

LOCAL_REDIS_PORT="6379"
LOCAL_NATS_PORT="4222"
LOCAL_SCYLLA_PORT="9042"
LOCAL_NOSTR_PORT="8081"
LOCAL_POSTGRES_PORT="15432"

# Generate genesis from this checkout's own circuits.  psy-node's genesis must
# match its own baseline circuits: the spike-era artifact produced a witness
# conflict ("Wire(row: 4372, column: 35) was set twice"), and parth's pinned
# artifacts belong to a different network entirely.
LOCAL_STAGING_BOOTSTRAP_GENESIS="1"
LOCAL_STAGING_GENESIS_USE_LLD="1"
LOCAL_STAGING_GENESIS_OPT_LEVEL="1"
LOCAL_STAGING_GENESIS_CODEGEN_UNITS="256"

# What a rollback verification needs, and nothing else.
LOCAL_STAGING_START_WORKERS="1"
LOCAL_STAGING_START_PROVE_PROXY="1"
LOCAL_STAGING_START_FAUCET_SERVER="1"
LOCAL_STAGING_START_PSY_SERVICES="0"
LOCAL_STAGING_START_INDEXERS="0"
LOCAL_STAGING_START_NGINX="0"
LOCAL_STAGING_PUBLISH_FRONTENDS="0"
LOCAL_STAGING_BUILD_FRONTENDS="0"
LOCAL_STAGING_NPM_INSTALL="0"

# psy-node keeps this artifact in the psy-genesis submodule rather than at the
# repository root, where up.sh looks for it.  It seeds psy-compiler's first
# build only; the generated artifact replaces it before any node starts.
LOCAL_STAGING_GENESIS_CONTRACTS_SEED="/home/peter/git/bridge_zilong/psy-node/psy-genesis/genesis_contracts.json"

# psy-compiler's workspace pins its circuit dependencies to parth-generic-v1 by
# path, so building it from psy-node would still compile parth's circuits -- and
# a genesis built from the wrong circuits is exactly what produced the witness
# conflict "Wire(row: 4372, column: 35) was set twice" earlier.  This copy has
# those eleven paths repointed at psy-node; the original repository is left
# untouched on its own branch.
#
# It also sidesteps a repository this machine does not have.  parth requires
# gnark-plonky2-wrapper unconditionally, while psy-node made it optional behind
# a feature, so the missing gnark-plonky2-verifier checkout is fatal to one and
# irrelevant to the other.
PSY_COMPILER_HOME="/home/peter/git/bridge_zilong/psy-compiler-for-psy-node"
