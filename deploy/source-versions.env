#!/usr/bin/env bash
# Compatibility loader. New deployments must select a network profile
# explicitly and use that profile's source-versions.env.

DEPLOY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=ethereum-sepolia/gcp/source-versions.env
source "$DEPLOY_ROOT/ethereum-sepolia/gcp/source-versions.env"
