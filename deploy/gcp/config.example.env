#!/usr/bin/env bash
# Compatibility loader for the historical Sepolia path. New configurations
# belong in deploy/ethereum-sepolia/gcp/config.env.

GCP_COMPAT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../ethereum-sepolia/gcp/config.example.env
source "$GCP_COMPAT_DIR/../ethereum-sepolia/gcp/config.example.env"
