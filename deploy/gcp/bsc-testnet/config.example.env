#!/usr/bin/env bash
# Compatibility loader. New BSC configurations belong in
# deploy/bsc-testnet/gcp/config.env.

BSC_COMPAT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../../bsc-testnet/gcp/config.example.env
source "$BSC_COMPAT_DIR/../../bsc-testnet/gcp/config.example.env"
