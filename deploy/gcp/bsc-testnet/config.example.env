#!/usr/bin/env bash
# BSC Testnet overlay for the existing public GCP topology.
# shellcheck disable=SC2034
#
# Copy this file to config.env (ignored by Git), then put secrets only in the
# ignored file. The base config supplies the current VM aliases, credentials,
# storage settings, and offsite topology; this overlay replaces every value
# that must not leak from the Sepolia deployment.

: "${WORKSPACE_HOME:?WORKSPACE_HOME must point at the bridge_zilong workspace}"
: "${BSC_BASE_GCP_CONFIG:=$WORKSPACE_HOME/parth-domain-merge/deploy/gcp/config.env}"

[ -f "$BSC_BASE_GCP_CONFIG" ] || {
  echo "missing BSC base GCP config: $BSC_BASE_GCP_CONFIG" >&2
  exit 1
}

# shellcheck disable=SC1090
source "$BSC_BASE_GCP_CONFIG"

# Source checkouts used to build this release.
PARTH_DIR="$WORKSPACE_HOME/psy-node-deploy-unified"
PSY_GENESIS_DIR="$PARTH_DIR/psy-genesis"
PSY_CONTRACTS_DIR="$PARTH_DIR/psy-contracts"
PSY_DAPP_DIR="$PARTH_DIR/psy-dapp"
PSY_SERVICES_DIR="$WORKSPACE_HOME/psy-services-cloud-deploy"

# Keep the Sepolia deployment's machine count, aliases, worker placement, and
# WireGuard/offsite topology unchanged. These are asserted again by preflight.
SCYLLA_VM_NAME="gcp-scylla"
NATS_VM_NAME="gcp-nats"
REDIS_VM_NAME="gcp-redis"
POSTGRES_VM_NAME="gcp-postgres"
NODE_VM_NAME="gcp-cp-ce"
ANVIL_VM_NAME="gcp-cp-ce"
COORDINATOR_WORKER_VM_NAME="gcp-coordinator-worker"
FAUCET_VM_NAME="gcp-faucet"
RELAYER_VM_NAME="gcp-faucet"
ENVIO_VM_NAME="gcp-postgres"
NOSTR_VM_NAME="gcp-nostr"
PROVE_PROXY_VM_NAME="gcp-prove-proxy"
REALM_WORKER_1_VM_NAME="gcp-realm-worker-0"
REALM_WORKER_2_VM_NAME="realm-worker-1"

DEPLOY_CLOUD_PROVE_PROXY="0"
DEPLOY_OFFSITE_PROVE_PROXY="1"
OFFSITE_PROVE_PROXY_HOST="arc99x2"
OFFSITE_PROVE_PROXY_APPLY_STAGED="1"
DEPLOY_CLOUD_REALM_WORKERS="1"
CLOUD_REALM_WORKER_LAYOUT="0:0 1:0"
DEPLOY_OFFSITE_WORKERS="1"
OFFSITE_WORKER_HOST="arc99x4"
OFFSITE_WORKER_REQUIRED="0"

# BSC Testnet L1. Set the RPC URL in ignored config.env. The deployment script
# verifies eth_chainId=97 before sending any transaction and records the actual
# pre-deployment block as Envio's START_BLOCK.
L1_DEPLOYMENTS_NETWORK="bsc-testnet"
RELAYER_DEPLOYMENTS_NETWORK="bsc-testnet"
CHAIN_ID="97"
BSC_TESTNET_RPC_URL="${BSC_TESTNET_RPC_URL:-}"
ETH_RPC_URL="$BSC_TESTNET_RPC_URL"
L1_RPC_URL="$BSC_TESTNET_RPC_URL"
RELAYER_L1_RPC_URL="$BSC_TESTNET_RPC_URL"
PUBLIC_L1_RPC_UPSTREAM="$BSC_TESTNET_RPC_URL"
START_BLOCK="0"
CLEAR_L1_LOCAL_STATE="1"
L1_DEPLOY_RESET="1"
PUBLIC_L1_EXPLORER_URL="https://testnet.bscscan.com"

# Do not inherit contract addresses from the Sepolia base config. Step 10 writes
# the freshly deployed BSC addresses back into this ignored profile.
ADDRESSES_PROVIDER_ADDRESS=""
BRIDGE_ADDRESS=""
STATE_MANAGER_ADDRESS=""
MULTICALL3_ADDRESS=""
ROUTER_ADDRESS=""
ERC20_GATEWAY_ADDRESS=""
ETH_GATEWAY_ADDRESS=""
WETH_ADDRESS=""
PSY_TOKEN_ADDRESS=""
USDT_TOKEN_ADDRESS=""
TOKEN_FAUCET_MANAGER_ADDRESS=""
RELAYER_BRIDGE_ADDRESS=""
RELAYER_STATE_MANAGER_ADDRESS=""

# Envio BSC Testnet indexing. Create a HyperSync token and store it only in the
# ignored config.env. ETH_RPC_URL remains the fallback source.
ENVIO_USE_HYPERSYNC="1"
ENVIO_HYPERSYNC_URL="https://bsc-testnet.hypersync.xyz"
ENVIO_API_TOKEN="${ENVIO_API_TOKEN:-}"
ENVIO_CONFIRMED_BLOCK_THRESHOLD="8"

# BSC-specific public names. Release aliases are disabled so this deployment
# cannot take over existing stg or release hostnames by accident.
PUBLIC_BASE_DOMAIN="psy-protocol.xyz"
PUBLIC_ENV_SLUG="bsc-testnet"
PUBLIC_ENABLE_RELEASE_BACKEND_ALIASES="0"
PUBLIC_CONFIG_ENVIRONMENT="bsc-testnet"

NOSTR_DOMAIN="nostr-bsc-testnet.psy-protocol.xyz"
NOSTR_ALIAS_DOMAINS=""
NOSTR_RELAY_URL="wss://nostr-bsc-testnet.psy-protocol.xyz/"
PUBLIC_COORDINATOR_DOMAIN="coordinator-bsc-testnet.psy-protocol.xyz"
PUBLIC_COORDINATOR_ALIAS_DOMAINS=""
PUBLIC_REALM_DOMAIN="realm0-bsc-testnet.psy-protocol.xyz"
PUBLIC_REALM0_DOMAIN="$PUBLIC_REALM_DOMAIN"
PUBLIC_REALM_ALIAS_DOMAINS=""
PUBLIC_REALM1_DOMAIN="realm1-bsc-testnet.psy-protocol.xyz"
PUBLIC_REALM1_ALIAS_DOMAINS=""
PUBLIC_PROVE_PROXY_DOMAIN="prove-bsc-testnet.psy-protocol.xyz"
PUBLIC_PROVE_PROXY_ALIAS_DOMAINS=""
PUBLIC_FAUCET_DOMAIN="faucet-bsc-testnet.psy-protocol.xyz"
PUBLIC_FAUCET_ALIAS_DOMAINS=""
PUBLIC_L1_RPC_DOMAIN="rpc-bsc-testnet.psy-protocol.xyz"
PUBLIC_L1_RPC_ALIAS_DOMAINS=""
PUBLIC_RPC_DOMAIN="$PUBLIC_L1_RPC_DOMAIN"
PUBLIC_PSY_SERVICES_DOMAIN="services-bsc-testnet.psy-protocol.xyz"
PUBLIC_PSY_SERVICES_ALIAS_DOMAINS=""
PUBLIC_INDEXER_DOMAIN="indexer-bsc-testnet.psy-protocol.xyz"
PUBLIC_INDEXER_ALIAS_DOMAINS=""
PUBLIC_TRUST_SETUP_DOMAIN="$NOSTR_DOMAIN"

PUBLIC_PRIVACY_BRIDGE_ORIGIN="https://app-bsc-testnet.psy-protocol.xyz"
PUBLIC_PRIVACY_BRIDGE_URL="$PUBLIC_PRIVACY_BRIDGE_ORIGIN/"
PUBLIC_PSY_EXPLORER_URL="https://explorer-bsc-testnet.psy-protocol.xyz/"
PUBLIC_PSY_IDE_URL="https://ide-bsc-testnet.psy-protocol.xyz/"
PUBLIC_CONFIG_PAGE_URL="https://config-bsc-testnet.psy-protocol.xyz/"
PUBLIC_WALLET_DOWNLOAD_URL="$PUBLIC_PRIVACY_BRIDGE_ORIGIN/wallet"

VITE_NETWORK="bsc-testnet"
VITE_L1_NETWORK="bsc-testnet"
VITE_DEPLOYMENTS_NETWORK="bsc-testnet"
VITE_L1_CHAIN_ID="97"
VITE_L1_CHAIN_NAME="BSC Testnet"
VITE_L1_CHAIN_SHORT_NAME="BSC Testnet"
VITE_L1_EXPLORER_URL="https://testnet.bscscan.com"

# Keep BSC frontends separate from the existing staging Pages projects.
CF_PAGES_BRANCH="bsc-testnet"
CF_PAGES_APP_PROJECT="psy-privacy-bridge-bsc-testnet"
CF_PAGES_EXPLORER_PROJECT="psy-explorer-bsc-testnet"
CF_PAGES_IDE_PROJECT="psy-ide-bsc-testnet"
CF_PAGES_CONFIG_PROJECT="psy-config-bsc-testnet"

# Wallet and SDK BSC publication have a separate release lifecycle. The default
# profile consumes the published SDK and R2 wallet metadata without rebuilding.
INCLUDE_WALLET_DOWNLOAD="0"
BUILD_LOCAL_PSY_SDK="0"
BSC_WALLET_PROFILE_VERIFIED="0"
