# Isolated local BSC-mode L1. These defaults do not overlap with the regular
# local testnet Anvil process on 127.0.0.1:8545.
BSC_LOCAL_CHAIN_ID=97
BSC_LOCAL_RPC_HOST=127.0.0.1
BSC_LOCAL_RPC_PORT=18545
BSC_LOCAL_BLOCK_TIME=1

# Defaults to <psy-node-worktree>/.local-bsc-testnet.
# BSC_LOCAL_STATE_ROOT=/path/to/isolated/state

# Defaults to the psy-contracts submodule in this worktree. During product
# development it may point at a clean BSC feature worktree.
# PSY_CONTRACTS_DIR=/path/to/psy-contracts

# Optional local-only Anvil deploy key override. Never use a public-testnet key
# here and never commit a real key.
# BSC_LOCAL_DEPLOY_PRIVATE_KEY=
