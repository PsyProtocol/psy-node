# Optional overrides for the complete local BSC-mode Psy stack.
# Copy this file to deploy/bsc-testnet/full-stack.env. The copied file is local
# configuration and must not be committed.

WORKSPACE_HOME="${WORKSPACE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"

# Product worktrees containing the BSC network changes.
BSC_RUNTIME_PARTH_DIR="$WORKSPACE_HOME/psy-node-bsc-testnet"
BSC_PSY_CONTRACTS_DIR="$WORKSPACE_HOME/psy-contracts-bsc-testnet"
BSC_PSY_GENESIS_DIR="$WORKSPACE_HOME/psy-genesis-bsc-testnet"
BSC_PSY_DAPP_DIR="$WORKSPACE_HOME/psy-dapp-bsc-testnet"
PSY_SERVICES_HOME="$WORKSPACE_HOME/psy-services-cloud-deploy"

# Optional shared Cargo target directories. These avoid duplicating a very
# large Plonky2 build cache across worktrees.
# BSC_RUNTIME_TARGET_DIR="$WORKSPACE_HOME/psy-node/target"
# BSC_PSY_SERVICES_TARGET_DIR="$WORKSPACE_HOME/psy-node/target"

# Set to 1 for the first run, or build the binaries manually beforehand.
BSC_LOCAL_BUILD="0"

# Reuse the existing Cargo artifacts without changing linker flags. Set to 1
# on lower-memory hosts where the genesis test link needs LLD.
BSC_LOCAL_GENESIS_USE_LLD="0"

# Pin Scylla so a new `latest` image cannot silently change host requirements.
# Scylla 2026.1 requires fs.aio-max-nr >= 67590 on this profile.
BSC_LOCAL_SCYLLA_IMAGE_TAG="2026.1.5"
BSC_LOCAL_MIN_AIO_NR="67590"
BSC_LOCAL_REQUIRE_SCYLLA_AIO="1"

# Refuse to start if a service needed by the selected phase already owns one
# of its ports. Set to 0 only while deliberately resuming a partial stack.
BSC_LOCAL_REQUIRE_FREE_PORTS="1"

# The full-stack profile is deliberately separate from deploy/local-testnet.
BSC_LOCAL_COMPOSE_PROJECT="parth-bsc-testnet"
BSC_LOCAL_CONTAINER_PREFIX="parth-bsc-local"

# Bridge defaults for a fast local E2E. These are not public BSC parameters.
BSC_LOCAL_RELAYER_MAX_CHECKPOINT_BATCH="8"
BSC_LOCAL_RELAYER_CONFIRMATION_LAG_CHECKPOINTS="1"
BSC_LOCAL_RELAYER_POLL_INTERVAL_SECS="2"

# Keep public exposure disabled during local validation.
BSC_LOCAL_START_TUNNEL="0"
BSC_LOCAL_PUBLISH_FRONTENDS="0"
