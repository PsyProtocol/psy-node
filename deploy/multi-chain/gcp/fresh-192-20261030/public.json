    "baseSepolia": {"rpc_url": "https://rpc-base-stg.psy-protocol.xyz", "explorer_url": "https://sepolia.basescan.org", "gas_faucet_url": "https://portal.cdp.coinbase.com/products/faucet"}
  },
  "services": {
    "coordinator_rpc": "https://coordinator-stg.psy-protocol.xyz",
