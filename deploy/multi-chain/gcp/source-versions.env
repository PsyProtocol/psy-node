export EXPECTED_PSY_SDK_NPM_VERSION="2.0.4"

export EXPECTED_GENESIS_CONTRACTS_SHA256="38b0a0af5735c53e7d581da39c9e9cc5151f13170e91263642a5fb2d92ed207b"

# Monitoring is deployed after every business-service and offsite-worker step.
