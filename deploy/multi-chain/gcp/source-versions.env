#!/usr/bin/env bash
# Authoritative source versions for the public multichain deployment profile.

export EXPECTED_PARTH_RUNTIME_REPOSITORY="PsyProtocol/psy-node"
export EXPECTED_PARTH_RUNTIME_COMMIT="ae7be0348287589207c89cce46ce2db6865f27ab"

# Relayer is a binary from the same psy-node revision, not a separate runtime.
# Keep these names for the standalone updater, but never pin them independently.
export EXPECTED_RELAYER_REPOSITORY="$EXPECTED_PARTH_RUNTIME_REPOSITORY"
export EXPECTED_RELAYER_COMMIT="$EXPECTED_PARTH_RUNTIME_COMMIT"

export EXPECTED_PSY_GENESIS_REPOSITORY="PsyProtocol/psy-genesis"
export EXPECTED_PSY_GENESIS_COMMIT="628e2fc785d61ccd780dc6a500a7fd7cf9ae161c"

export EXPECTED_PSY_CONTRACTS_REPOSITORY="PsyProtocol/psy-contracts"
export EXPECTED_PSY_CONTRACTS_COMMIT="d59d83ecb7508669606f650fa0abbc1abffbcb15"

export EXPECTED_PSY_DAPP_REPOSITORY="PsyProtocol/psy-dapp"
export EXPECTED_PSY_DAPP_COMMIT="dddf10677b91894cb626b3e717702fc33feeb77f"

export EXPECTED_PSY_SERVICES_REPOSITORY="PsyProtocol/psy-services"
export EXPECTED_PSY_SERVICES_BRANCH="multi_chain"
export EXPECTED_PSY_SERVICES_COMMIT="9122e5de2d33ea6aba6d7bef101e742198879836"

# The wallet uses one Psy staging profile; L1 routes are selected by protocol
# chain index (Sepolia=0, BSC Testnet=1, Base Sepolia=2).
# These pins are checked only when local wallet/SDK builds are explicitly on.
export EXPECTED_PSY_WALLET_REPOSITORY="PsyProtocol/psy-wallet"
export EXPECTED_PSY_WALLET_COMMIT="5ecd8c02b6013413d658b46592dd9115d94bba4e"

export EXPECTED_PSY_SDK_REPOSITORY="PsyProtocol/psy-sdk"
export EXPECTED_PSY_SDK_COMMIT="4146f805ff016df7581ff1a987b89e8c1812b3dd"
export EXPECTED_PSY_SDK_NPM_VERSION="2.0.6"

export EXPECTED_GENESIS_CONTRACTS_SHA256="315d534a5d04d025c82b3df2431c851a4b3e12a9d2f9100f41f12fbbfb733e79"

# Monitoring is deployed after every business-service and offsite-worker step.
export EXPECTED_PSY_NOTIFIER_REPOSITORY="PsyProtocol/psy-notifier"
export EXPECTED_PSY_NOTIFIER_COMMIT="9d85ffada628a19a2b561f61b071788fe49b650c"
