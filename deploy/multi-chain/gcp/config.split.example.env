# Non-secret preparation profile. No current VM is created, moved or resized.
source "$(dirname "${BASH_SOURCE[0]}")/config.example.env"
DEPLOY_TOPOLOGY_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fresh-topology/topology.json"
DEPLOY_STEPS_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/fresh-topology/steps.tsv"
DEPLOY_OFFSITE_WORKERS=0
COORDINATOR_WORKER_VM_NAME=gcp-c4d-1
WORKER_VM_NAME=gcp-c4d-1
COORDINATOR_WORKER_LAYOUT=0
CLOUD_REALM_WORKER_LAYOUT="0:0 0:1 1:0 1:1"
FAUCET_VM_NAME=gcp-coordinator-worker
RELAYER_VM_NAME=gcp-faucet
# topology.json owns component placement; NODE_VM_NAME is only a legacy fallback.
NODE_VM_NAME=gcp-cp-ce
