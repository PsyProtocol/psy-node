#!/usr/bin/env bash
# This file is sourced by deployment entrypoints; its assignments are the API.
# shellcheck disable=SC2034
# Public GCP multichain overlay: Sepolia + BSC Testnet + Base Sepolia.
# Copy to config.env (ignored), replace secrets/placeholders, and keep the
# three RPC URLs private. Public clients use the per-chain Caddy hostnames.

: "${WORKSPACE_HOME:?WORKSPACE_HOME must point at the shared workspace}"
MULTICHAIN_PROFILE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MULTICHAIN_REPO_ROOT="$(cd "$MULTICHAIN_PROFILE_DIR/../../.." && pwd)"
_MULTICHAIN_SEPOLIA_RPC_URL="${SEPOLIA_RPC_URL:-}"
_MULTICHAIN_BSC_TESTNET_RPC_URL="${BSC_TESTNET_RPC_URL:-}"
_MULTICHAIN_BASE_SEPOLIA_RPC_URL="${BASE_SEPOLIA_RPC_URL:-}"

# Reuse the established machine topology and operational defaults. Every
# network-sensitive setting is replaced below.
# shellcheck source=../../ethereum-sepolia/gcp/config.example.env
source "$MULTICHAIN_REPO_ROOT/deploy/ethereum-sepolia/gcp/config.example.env"

PARTH_DIR="$MULTICHAIN_REPO_ROOT"
PSY_GENESIS_DIR="$PARTH_DIR/psy-genesis"
PSY_CONTRACTS_DIR="$PARTH_DIR/psy-contracts"
PSY_DAPP_DIR="$PARTH_DIR/psy-dapp"
PSY_SERVICES_DIR="$WORKSPACE_HOME/psy-services-merge-multi-chain"

MULTICHAIN_L1_ENABLED="1"
MULTICHAIN_PRIMARY_NETWORK="sepolia"
MULTICHAIN_L1_RUNTIME_FILE="$MULTICHAIN_PROFILE_DIR/runtime/l1-deployments.json"

# Private upstream RPCs. Use dedicated authenticated endpoints in config.env.
SEPOLIA_RPC_URL="$_MULTICHAIN_SEPOLIA_RPC_URL"
BSC_TESTNET_RPC_URL="$_MULTICHAIN_BSC_TESTNET_RPC_URL"
BASE_SEPOLIA_RPC_URL="$_MULTICHAIN_BASE_SEPOLIA_RPC_URL"
unset _MULTICHAIN_SEPOLIA_RPC_URL _MULTICHAIN_BSC_TESTNET_RPC_URL \
  _MULTICHAIN_BASE_SEPOLIA_RPC_URL

# One protocol chain index per EVM testnet. `network` must match the
# psy-contracts deployment directory names exactly.
MULTICHAIN_L1_CHAINS_JSON="$(jq -cn \
  --arg sepolia_rpc "$SEPOLIA_RPC_URL" \
  --arg bsc_rpc "$BSC_TESTNET_RPC_URL" \
  --arg base_rpc "$BASE_SEPOLIA_RPC_URL" '
  [
    {
      name: "Ethereum Sepolia",
      network: "sepolia",
      chain_id: 11155111,
      chain_index: 0,
      rpc_url: $sepolia_rpc,
      public_rpc_domain: "rpc-eth-stg.psy-protocol.xyz",
      explorer_url: "https://sepolia.etherscan.io",
      gas_faucet_url: "https://cloud.google.com/application/web3/faucet/ethereum/sepolia",
      use_hypersync: true,
      hypersync_url: "https://sepolia.hypersync.xyz"
    },
    {
      name: "BSC Testnet",
      network: "bscTestnet",
      chain_id: 97,
      chain_index: 1,
      rpc_url: $bsc_rpc,
      public_rpc_domain: "rpc-bsc-stg.psy-protocol.xyz",
      explorer_url: "https://testnet.bscscan.com",
      gas_faucet_url: "https://faucet.zalalena.com/bsc",
      use_hypersync: true,
      hypersync_url: "https://bsc-testnet.hypersync.xyz"
    },
    {
      name: "Base Sepolia",
      network: "baseSepolia",
      chain_id: 84532,
      chain_index: 2,
      rpc_url: $base_rpc,
      public_rpc_domain: "rpc-base-stg.psy-protocol.xyz",
      explorer_url: "https://sepolia.basescan.org",
      gas_faucet_url: "https://portal.cdp.coinbase.com/products/faucet",
      use_hypersync: true,
      hypersync_url: "https://base-sepolia.hypersync.xyz"
    }
  ]')"

# Legacy single-chain fields always describe the primary chain. Step 10
# replaces addresses and START_BLOCK after deploying all three L1 contracts.
L1_DEPLOYMENTS_NETWORK="sepolia"
RELAYER_DEPLOYMENTS_NETWORK="sepolia"
CHAIN_ID="11155111"
ETH_RPC_URL="$SEPOLIA_RPC_URL"
L1_RPC_URL="$SEPOLIA_RPC_URL"
START_BLOCK="0"
CLEAR_L1_LOCAL_STATE="1"
L1_DEPLOY_RESET="1"
PUBLIC_L1_EXPLORER_URL="https://sepolia.etherscan.io"

ADDRESSES_PROVIDER_ADDRESS=""
BRIDGE_ADDRESS=""
STATE_MANAGER_ADDRESS=""
MULTICALL3_ADDRESS=""
ROUTER_ADDRESS=""
ERC20_GATEWAY_ADDRESS=""
ETH_GATEWAY_ADDRESS=""
WETH_ADDRESS=""
PSY_TOKEN_ADDRESS=""
USDT_TOKEN_ADDRESS=""
TOKEN_FAUCET_MANAGER_ADDRESS=""
RELAYER_BRIDGE_ADDRESS=""
RELAYER_STATE_MANAGER_ADDRESS=""

# The same signer deploys/finalizes on every L1. Fund this address on all
# three testnets before deployment. Keep password/key material in config.env.
L1_DEPLOYER_KEYSTORE_PATH="${L1_DEPLOYER_KEYSTORE_PATH:-$HOME/.psy/keystore/bridge-relayer-dev}"
L1_DEPLOYER_WALLET_PASSWORD="${L1_DEPLOYER_WALLET_PASSWORD:-${WALLET_PASSWORD:-}}"
L1_DEPLOYER_ADDRESS="${L1_DEPLOYER_ADDRESS:-}"
RELAYER_FINALIZE_EXPECTED_ADDRESS="${RELAYER_FINALIZE_EXPECTED_ADDRESS:-$L1_DEPLOYER_ADDRESS}"
MULTICHAIN_MIN_DEPLOYER_BALANCE_WEI="${MULTICHAIN_MIN_DEPLOYER_BALANCE_WEI:-100000000000000000}"

# One Envio process indexes all three networks into the shared schema. A token
# is mandatory because every configured source uses HyperSync.
ENVIO_USE_HYPERSYNC="1"
ENVIO_API_TOKEN="${ENVIO_API_TOKEN:-}"
ENVIO_CONFIRMED_BLOCK_THRESHOLD="8"

# One public hostname per L1 prevents ambiguous eth_chainId responses. Add
# all three DNS records to the gcp-nostr/Caddy public IP before step 17.
PUBLIC_L1_RPC_DOMAIN=""
PUBLIC_RPC_DOMAIN=""
PUBLIC_L1_RPC_ALIAS_DOMAINS=""

PUBLIC_CONFIG_ENVIRONMENT="multi-chain-testnet"
VITE_NETWORK="sepolia"
VITE_L1_NETWORK="sepolia"
VITE_DEPLOYMENTS_NETWORK="sepolia"
VITE_L1_CHAIN_ID="11155111"
VITE_L1_CHAIN_NAME="Sepolia"
VITE_L1_CHAIN_SHORT_NAME="Sepolia"
VITE_L1_EXPLORER_URL="https://sepolia.etherscan.io"

# Keep the existing staging Pages projects and R2-hosted wallet. Product
# backends are never auto-deployed by the frontend workflow.
CF_PAGES_BRANCH="staging"
CF_PAGES_APP_PROJECT="psy-privacy-bridge-demo-stg"
CF_PAGES_EXPLORER_PROJECT="psy-explorer-stg"
CF_PAGES_IDE_PROJECT="psy-ide-stg"
CF_PAGES_CONFIG_PROJECT="psy-config-stg"
INCLUDE_WALLET_DOWNLOAD="0"
BUILD_LOCAL_PSY_SDK="0"

# Preserve current cloud/offsite placement.
COORDINATOR_WORKER_LAYOUT="0"
COORDINATOR_WORKER_KEY_INDEXES="0"
REQUIRE_MIN_COORDINATOR_WORKERS="1"
DEPLOY_CLOUD_REALM_WORKERS="1"
CLOUD_REALM_WORKER_LAYOUT="0:0 1:0"
DEPLOY_OFFSITE_WORKERS="1"
OFFSITE_WORKER_HOST="arc99x4"
OFFSITE_WORKER_REQUIRED="0"
DEPLOY_CLOUD_PROVE_PROXY="0"
DEPLOY_OFFSITE_PROVE_PROXY="1"
OFFSITE_PROVE_PROXY_HOST="arc99x2"
OFFSITE_PROVE_PROXY_APPLY_STAGED="1"
# Set these in config.env to the WireGuard gateway's VPC-side prove endpoint.
CLIENT_PROVE_PROXY_URL="${CLIENT_PROVE_PROXY_URL:-}"
PUBLIC_PROVE_PROXY_UPSTREAM="${PUBLIC_PROVE_PROXY_UPSTREAM:-}"

# Required secrets inherited from the shared profile still need real values:
# POSTGRES_PASSWORD, HASURA_GRAPHQL_ADMIN_SECRET, PSY_JWT_SECRET,
# ENVIO_API_TOKEN, Cloudflare credentials, and the L1 keystore password.
