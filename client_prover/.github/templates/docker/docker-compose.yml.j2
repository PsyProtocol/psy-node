version: '3.8'

# Docker Compose automatically loads .env file from the same directory
# All environment variables from .env are available to containers
# Config.json env vars will override .env vars if there are conflicts


networks:
  {{ config.nodes.deployment.docker.network_name }}:
    driver: bridge
    ipam:
      config:
        - subnet: {{ config.nodes.deployment.docker.network_subnet }}

volumes:
  # Check if coordinator uses lmdbx
  {% set coord_backend = config.nodes.coordinator.backend -%}
  {% if coord_backend.type == "lmdbx" -%}
  coordinator_data:
  {% endif -%}
  # Check each realm for lmdbx usage
  {% for realm in config.nodes.realms -%}
  {% set realm_backend = realm.backend -%}
  # Realm {{ realm.id }} backend type: {{ realm_backend.type if realm_backend else "None" }}
  {% if realm_backend.type == "lmdbx" -%}
  realm{{ realm.id }}_data:
  {% endif -%}
  {% endfor -%}
  # Include ScyllaDB volumes if any node uses it
  {% set ns = namespace(uses_scylla=false) -%}
  {% set coord_backend = config.nodes.coordinator.backend -%}
  {% if coord_backend.type == "scylla" -%}
  {% set ns.uses_scylla = true -%}
  {% endif -%}
  {% for realm in config.nodes.realms -%}
  {% set realm_backend = realm.backend -%}
  {% if realm_backend.type == "scylla" -%}
  {% set ns.uses_scylla = true -%}
  {% endif -%}
  {% endfor -%}
  {% if ns.uses_scylla -%}
  # Coordinator ScyllaDB volumes
  {% if config.nodes.coordinator.backend and config.nodes.coordinator.backend.database == "scylla" -%}
    {% set coordinator_cluster_size = config.nodes.coordinator.backend.scylla.aws.ec2.desired_instances | default(1) -%}
  {% else -%}
    {% set coordinator_cluster_size = 0 -%}
  {% endif -%}
  {% if coordinator_cluster_size > 0 -%}
  {% for i in range(1, coordinator_cluster_size + 1) -%}
  scylla_coordinator_{{ i }}_data:
  scylla_coordinator_{{ i }}_commitlog:
  {% endfor -%}
  {% endif -%}
  # Realm ScyllaDB volumes
  {% for realm in config.nodes.realms -%}
  {% if realm.backend and realm.backend.type == "scylla" -%}
    {% set realm_cluster_size = realm.backend.scylla.aws.ec2.desired_instances | default(1) -%}
  {% else -%}
    {% set realm_cluster_size = 0 -%}
  {% endif -%}
  {% if realm_cluster_size > 0 -%}
  {% for i in range(1, realm_cluster_size + 1) -%}
  scylla_realm{{ realm.id }}_{{ i }}_data:
  scylla_realm{{ realm.id }}_{{ i }}_commitlog:
  {% endfor -%}
  {% endif -%}
  {% endfor -%}
  {% endif %}

services:
  # Redis services
  {% if config.nodes.coordinator.redis -%}
  redis-coordinator:
    image: redis:7-alpine
    container_name: psy-redis-coordinator
    ports:
      - "{{ config.nodes.coordinator.redis.uri | split(':') | last }}:6379"
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    restart: unless-stopped

  {% endif -%}
  {% for realm in config.nodes.realms -%}
  {% if realm.redis -%}
  redis-realm{{ realm.id }}:
    image: redis:7-alpine
    container_name: psy-redis-realm{{ realm.id }}
    ports:
      - "{{ realm.redis.uri | split(':') | last }}:6379"
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    restart: unless-stopped

  {% endif -%}
  {% endfor %}

  # ScyllaDB - only include if any node uses scylla backend
  {% set ns = namespace(uses_scylla=false) -%}
  {% set coord_backend = config.nodes.coordinator.backend -%}
  {% if coord_backend.type == "scylla" -%}
  {% set ns.uses_scylla = true -%}
  {% endif -%}
  {% for realm in config.nodes.realms -%}
  {% set realm_backend = realm.backend -%}
  {% if realm_backend.type == "scylla" -%}
  {% set ns.uses_scylla = true -%}
  {% endif -%}
  {% endfor -%}
  {% if ns.uses_scylla -%}
  # ScyllaDB clusters

  # Coordinator ScyllaDB cluster
  {% if config.nodes.coordinator.backend and config.nodes.coordinator.database == "scylla" -%}
    {% set coordinator_cluster_size = config.nodes.coordinator.backend.scylla.aws.ec2.desired_instances | default(1) -%}
  {% else -%}
    {% set coordinator_cluster_size = 0 -%}
  {% endif -%}

  {% if coordinator_cluster_size > 0 -%}
  {% for i in range(1, coordinator_cluster_size + 1) -%}
  scylla-coordinator-{{ i }}:
    image: scylladb/scylla:2025.1
    container_name: psy-scylla-coordinator-{{ i }}
    ports:
      - "{{ 9041 + i }}:9042"
      - "{{ 9179 + i }}:9180"
    command: >
      --smp 2
      --memory 4G
      --overprovisioned 1
      --api-address 0.0.0.0
      --seeds scylla-coordinator-1
    volumes:
      - scylla_coordinator_{{ i }}_data:/var/lib/scylla
      - scylla_coordinator_{{ i }}_commitlog:/var/lib/scylla/commitlog
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    restart: unless-stopped
    pid: host
    {% if i > 1 -%}
    depends_on:
      - scylla-coordinator-1
    {% endif -%}
    healthcheck:
      test: ["CMD", "cqlsh", "-e", "describe keyspaces"]
      interval: 30s
      timeout: 10s
      retries: 5

  {% endfor -%}
  {% endif -%}

  # Realm ScyllaDB clusters
  {% for realm in config.nodes.realms -%}
  {% if realm.backend and realm.backend.type == "scylla" -%}
    {% set realm_cluster_size = realm.backend.scylla.aws.ec2.desired_instances | default(1) -%}
  {% else -%}
    {% set realm_cluster_size = 0 -%}
  {% endif -%}

  {% if realm_cluster_size > 0 -%}
  {% for i in range(1, realm_cluster_size + 1) -%}
  scylla-realm{{ realm.id }}-{{ i }}:
    image: scylladb/scylla:2025.1
    container_name: psy-scylla-realm{{ realm.id }}-{{ i }}
    ports:
      {% if realm.id == 0 -%}
      - "{{ 9051 + i }}:9042"
      - "{{ 9189 + i }}:9180"
      {% elif realm.id == 1 -%}
      - "{{ 9061 + i }}:9042"
      - "{{ 9199 + i }}:9180"
      {% endif %}
    command: >
      --smp 2
      --memory 4G
      --overprovisioned 1
      --api-address 0.0.0.0
      --seeds scylla-realm{{ realm.id }}-1
    volumes:
      - scylla_realm{{ realm.id }}_{{ i }}_data:/var/lib/scylla
      - scylla_realm{{ realm.id }}_{{ i }}_commitlog:/var/lib/scylla/commitlog
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    restart: unless-stopped
    pid: host
    {% if i > 1 -%}
    depends_on:
      - scylla-realm{{ realm.id }}-1
    {% endif -%}
    healthcheck:
      test: ["CMD", "cqlsh", "-e", "describe keyspaces"]
      interval: 30s
      timeout: 10s
      retries: 5

  {% endfor -%}
  {% endif -%}
  {% endfor -%}
  {% endif -%}

  # Coordinator services
  {% if config.nodes.coordinator.processor.enabled -%}
  coordinator-processor:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-coordinator-processor
    command: >
      coordinator-processor
      {% if config.nodes.coordinator.backend -%}
      {% set coord_backend = config.nodes.coordinator.backend -%}
      {% else -%}
      {% set coord_backend = config.nodes.backend -%}
      {% endif -%}
      {% if coord_backend.type == "lmdbx" -%}
      --database lmdbx
      --lmdbx-path /data
      {% elif coord_backend.type == "scylla" -%}
      --database scylla
      {% set coord_cluster_size = coord_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      --scylla-uri scylla-coordinator-1:9042
      --scylla-keyspace psy_coordinator
      {% endif -%}
      --redis-uri redis://redis-coordinator:6379
      {% for key, value in config.nodes.coordinator.processor.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    environment:
      {% for key, value in config.nodes.coordinator.processor.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    {% if config.nodes.coordinator.backend -%}
    {% set coord_backend = config.nodes.coordinator.backend -%}
    {% else -%}
    {% set coord_backend = config.nodes.backend -%}
    {% endif -%}
    {% if coord_backend.type == "lmdbx" -%}
    volumes:
      - coordinator_data:/data
    {% endif -%}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-coordinator
      {% if config.nodes.coordinator.backend -%}
      {% set coord_backend = config.nodes.coordinator.backend -%}
      {% else -%}
      {% set coord_backend = config.nodes.backend -%}
      {% endif -%}
      {% if coord_backend.type == "scylla" -%}
      {% set coord_cluster_size = coord_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      {% for i in range(1, coord_cluster_size + 1) -%}
      - scylla-coordinator-{{ i }}
      {% endfor -%}
      {% endif %}
    restart: unless-stopped
    pid: host

  {% endif -%}

  {% if config.nodes.coordinator.edge.enabled -%}
  coordinator-edge:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-coordinator-edge
    ports:
      - "{{ (config.nodes.coordinator.edge.args.listen_addr | default('0.0.0.0:8545')) | split(':') | last }}:8545"
    command: >
      coordinator-edge
      {% if config.nodes.coordinator.backend -%}
      {% set coord_backend = config.nodes.coordinator.backend -%}
      {% else -%}
      {% set coord_backend = config.nodes.backend -%}
      {% endif -%}
      {% if coord_backend.type == "lmdbx" -%}
      --database lmdbx
      --lmdbx-path /data
      {% elif coord_backend.type == "scylla" -%}
      --database scylla
      {% set coord_cluster_size = coord_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      --scylla-uri scylla-coordinator-1:9042
      --scylla-keyspace psy_coordinator
      {% endif -%}
      --redis-uri redis://redis-coordinator:6379
      {% for key, value in config.nodes.coordinator.edge.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    env_file:
      - .env
    environment:
      {% for key, value in config.nodes.coordinator.edge.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    {% if config.nodes.coordinator.backend -%}
    {% set coord_backend = config.nodes.coordinator.backend -%}
    {% else -%}
    {% set coord_backend = config.nodes.backend -%}
    {% endif -%}
    {% if coord_backend.type == "lmdbx" -%}
    volumes:
      - coordinator_data:/data
    {% endif -%}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-coordinator
      - coordinator-processor
      {% if config.nodes.coordinator.backend -%}
      {% set coord_backend = config.nodes.coordinator.backend -%}
      {% else -%}
      {% set coord_backend = config.nodes.backend -%}
      {% endif -%}
      {% if coord_backend.type == "scylla" -%}
      {% set coord_cluster_size = coord_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      {% for i in range(1, coord_cluster_size + 1) -%}
      - scylla-coordinator-{{ i }}
      {% endfor -%}
      {% endif %}
    restart: unless-stopped
    pid: host

  {% endif -%}

  {% if config.nodes.coordinator.worker.enabled -%}
  {% for i in range(config.nodes.coordinator.worker.instances or 1) -%}
  coordinator-worker-{{ i }}:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-coordinator-worker-{{ i }}
    command: >
      coordinator-worker
      --redis-uri redis://redis-coordinator:6379
      {% for key, value in config.nodes.coordinator.worker.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    environment:
      {% for key, value in config.nodes.coordinator.worker.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-coordinator
      - coordinator-processor
      {% if config.nodes.coordinator.backend -%}
      {% set coord_backend = config.nodes.coordinator.backend -%}
      {% else -%}
      {% set coord_backend = config.nodes.backend -%}
      {% endif -%}
      {% if coord_backend.type == "scylla" -%}
      {% set coord_cluster_size = coord_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      {% for i in range(1, coord_cluster_size + 1) -%}
      - scylla-coordinator-{{ i }}
      {% endfor -%}
      {% endif %}
    restart: unless-stopped
    pid: host

  {% endfor %}
  {% endif -%}

  # Realm services
  {% for realm in config.nodes.realms -%}
  {% if realm.processor.enabled -%}
  realm{{ realm.id }}-processor:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-realm{{ realm.id }}-processor
    command: >
      realm-processor
      {% if realm.backend -%}
      {% set realm_backend = realm.backend -%}
      {% else -%}
      {% set realm_backend = config.nodes.backend -%}
      {% endif -%}
      {% if realm_backend.type == "lmdbx" -%}
      --database lmdbx
      --lmdbx-path /data
      {% elif realm_backend.type == "scylla" -%}
      --database scylla
      {% set realm_cluster_size = realm_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      --scylla-uri scylla-realm{{ realm.id }}-1:9042
      --scylla-keyspace psy_realm_{{ realm.id }}
      {% endif -%}
      --redis-uri redis://redis-realm{{ realm.id }}:6379
      --realm-id {{ realm.id }}
      {% for key, value in realm.processor.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    environment:
      {% for key, value in realm.processor.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    {% if realm.backend -%}
    {% set realm_backend = realm.backend -%}
    {% else -%}
    {% set realm_backend = config.nodes.backend -%}
    {% endif -%}
    {% if realm_backend.type == "lmdbx" -%}
    volumes:
      - realm{{ realm.id }}_data:/data
    {% endif -%}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-realm{{ realm.id }}
      {% if realm.backend -%}
      {% set realm_backend = realm.backend -%}
      {% else -%}
      {% set realm_backend = config.nodes.backend -%}
      {% endif -%}
      {% if realm_backend.type == "scylla" -%}
      {% set realm_cluster_size = realm_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      {% for i in range(1, realm_cluster_size + 1) -%}
      - scylla-realm{{ realm.id }}-{{ i }}
      {% endfor -%}
      {% endif %}
    restart: unless-stopped
    pid: host

  {% endif -%}

  {% if realm.edge.enabled -%}
  realm{{ realm.id }}-edge:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-realm{{ realm.id }}-edge
    ports:
      - "{{ (realm.edge.args['listen-addr'] | default('0.0.0.0:' ~ (8546 + realm.id))) | split(':') | last }}:{{ 8546 + realm.id }}"
    command: >
      realm-edge
      {% if realm.backend -%}
      {% set realm_backend = realm.backend -%}
      {% else -%}
      {% set realm_backend = config.nodes.backend -%}
      {% endif -%}
      {% if realm_backend.type == "lmdbx" -%}
      --database lmdbx
      --lmdbx-path /data
      {% elif realm_backend.type == "scylla" -%}
      --database scylla
      {% set realm_cluster_size = realm_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      --scylla-uri scylla-realm{{ realm.id }}-1:9042
      --scylla-keyspace psy_realm_{{ realm.id }}
      {% endif -%}
      --redis-uri redis://redis-realm{{ realm.id }}:6379
      --realm-id {{ realm.id }}
      {% for key, value in realm.edge.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    env_file:
      - .env
    environment:
      {% for key, value in realm.edge.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    {% if realm.backend -%}
    {% set realm_backend = realm.backend -%}
    {% else -%}
    {% set realm_backend = config.nodes.backend -%}
    {% endif -%}
    {% if realm_backend.type == "lmdbx" -%}
    volumes:
      - realm{{ realm.id }}_data:/data
    {% endif -%}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-realm{{ realm.id }}
      - realm{{ realm.id }}-processor
      - coordinator-edge
      {% if realm.backend -%}
      {% set realm_backend = realm.backend -%}
      {% else -%}
      {% set realm_backend = config.nodes.backend -%}
      {% endif -%}
      {% if realm_backend.type == "scylla" -%}
      {% set realm_cluster_size = realm_backend.scylla.aws.ec2.desired_instances | default(1) -%}
      {% for i in range(1, realm_cluster_size + 1) -%}
      - scylla-realm{{ realm.id }}-{{ i }}
      {% endfor -%}
      {% endif %}
    restart: unless-stopped
    pid: host

  {% endif -%}

  {% if realm.worker.enabled -%}
  {% for i in range(realm.worker.instances or 1) -%}
  realm{{ realm.id }}-worker-{{ i }}:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-realm{{ realm.id }}-worker-{{ i }}
    command: >
      realm-worker
      --redis-uri redis://redis-realm{{ realm.id }}:6379
      {% for key, value in realm.worker.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    environment:
      {% for key, value in realm.worker.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    depends_on:
      - redis-realm{{ realm.id }}
      - realm{{ realm.id }}-processor
    restart: unless-stopped
    pid: host

  {% endfor %}
  {% endif -%}

  {% endfor %}

  # Local prover service
  {% if config.nodes.prover and config.nodes.prover.enabled -%}
  prover:
    build:
      context: .
      dockerfile: Dockerfile
      args:
        PROFILE: release
    container_name: psy-prover
    entrypoint: ["/psy-node/psy_user_cli"]
    ports:
      - "{{ (config.nodes.prover.args.listen_addr | default('0.0.0.0:8888')) | split(':') | last }}:{{ (config.nodes.prover.args.listen_addr | default('0.0.0.0:8888')) | split(':') | last }}"
    command: >
      local-prover
      {% for key, value in config.nodes.prover.args | items -%}
      --{{ key | replace('_', '-') }} {{ value }}
      {% endfor %}
    environment:
      {% for key, value in config.nodes.prover.env | items -%}
      {{ key }}: "{{ value }}"
      {% endfor %}
    volumes:
      - ./config.json:/psy-node/config.json:ro
    networks:
      - {{ config.nodes.deployment.docker.network_name }}
    restart: unless-stopped
    pid: host
  {% endif -%}
