      GroupDescription: Security group for realm {{ realm.id }} services
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
        - IpProtocol: tcp
          FromPort: {{ 8546 + loop.index0 }}
          ToPort: {{ 8546 + loop.index0 }}
          SourceSecurityGroupId: !Ref ALBSecurityGroup
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-sg'

  # Realm {{ realm.id }} Redis Security Group - ISOLATED
  Realm{{ realm.id }}RedisSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for Realm {{ realm.id }} Redis
      VpcId: !Ref VPC
      SecurityGroupIngress:
        # Only allow this realm's services
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
          Description: Redis access from Realm {{ realm.id }} services
        - IpProtocol: tcp
          FromPort: 6379
          ToPort: 6379
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: Redis access from Realm {{ realm.id }} ECS tasks
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-redis-sg'

  Realm{{ realm.id }}InternalIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: -1
      SourceSecurityGroupId: !Ref Realm{{ realm.id }}SecurityGroup
      Description: Internal communication
  {% endfor %}

  # Allow Realm services to connect to Coordinator Edge
  CoordinatorEdgeFromRealmsIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref ECSSecurityGroup
      IpProtocol: tcp
      FromPort: 8545
      ToPort: 8545
      SourceSecurityGroupId: !Ref ECSSecurityGroup
      Description: Allow Realm services to connect to Coordinator Edge

  {% for realm in config.nodes.realms %}
  # Allow cross-service communication for Realm {{ realm.id }}
  Realm{{ realm.id }}CrossServiceIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref Realm{{ realm.id }}SecurityGroup
      IpProtocol: tcp
      FromPort: {{ 8546 + realm.id }}
      ToPort: {{ 8546 + realm.id }}
      SourceSecurityGroupId: !Ref ECSSecurityGroup
      Description: Cross-service communication for Realm {{ realm.id }}
  {% endfor %}

  # Coordinator Processor Launch Template
  CoordinatorProcessorLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-coordinator-processor-lt'
      LaunchTemplateData:
        ImageId: !Ref LatestAmiId  
        InstanceType: c6i.2xlarge
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref CoordinatorSecurityGroup
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
              - Key: Service
                Value: coordinator-processor
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1

            # Update system and install Docker
            apt-get update -y
            apt-get install -y docker.io awscli jq netcat curl
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Install CloudWatch agent for Docker logging
            cd /tmp
            wget https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
            dpkg -i -E ./amazon-cloudwatch-agent.deb || true
            
            # Configure awslogs for Docker
            cat > /etc/docker/daemon.json <<EOF
            {
              "log-driver": "json-file",
              "log-opts": {
                "max-size": "100m",
                "max-file": "5"
              }
            }
            EOF
            
            # Restart Docker to apply logging configuration
            systemctl restart docker
            
            # Create CloudWatch Logs configuration for Docker
            cat > /opt/aws/amazon-cloudwatch-agent/etc/docker-logs.json <<EOF
            {
              "logs": {
                "logs_collected": {
                  "files": {
                    "collect_list": [
                      {
                        "file_path": "/var/lib/docker/containers/*/*.log",
                        "log_group_name": "{{ config.nodes.deployment.aws.ecs.log_group }}",
                        "log_stream_name": "coordinator-processor-{instance_id}",
                        "timezone": "UTC"
                      }
                    ]
                  }
                }
              }
            }
            EOF
            
            # Start CloudWatch agent
            /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
              -a fetch-config \
              -m ec2 \
              -s \
              -c file:/opt/aws/amazon-cloudwatch-agent/etc/docker-logs.json

            # Login to ECR
            aws ecr get-login-password --region ${AWS::Region} | docker login --username AWS --password-stdin ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

            # Pull the Docker image first
            docker pull ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest

            # Get TiKV PD endpoints
            MAX_RETRIES=30
            RETRY_COUNT=0

            while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
              PD_INSTANCE_IDS=$(aws autoscaling describe-auto-scaling-groups \
                --auto-scaling-group-names "${ProjectName}-${Environment}-tikv-pd-asg" \
                --query 'AutoScalingGroups[0].Instances[*].InstanceId' \
                --output text \
                --region ${AWS::Region} 2>/dev/null || echo "")

              if [ -n "$PD_INSTANCE_IDS" ]; then
                PD_ENDPOINTS=""
                for id in $PD_INSTANCE_IDS; do
                  IP=$(aws ec2 describe-instances \
                    --instance-ids $id \
                    --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                    --output text \
                    --region ${AWS::Region})
                  if [ -n "$IP" ]; then
                    if [ -z "$PD_ENDPOINTS" ]; then
                      PD_ENDPOINTS="$IP:2379"
                    else
                      PD_ENDPOINTS="$PD_ENDPOINTS,$IP:2379"
                    fi
                  fi
                done

                if [ -n "$PD_ENDPOINTS" ]; then
                  echo "Got TiKV PD endpoints: $PD_ENDPOINTS"
                  break
                fi
              fi

              echo "Waiting for TiKV PD cluster... attempt $((RETRY_COUNT + 1)) of $MAX_RETRIES"
              RETRY_COUNT=$((RETRY_COUNT + 1))
              sleep 10
            done

            if [ -z "$PD_ENDPOINTS" ]; then
              echo "ERROR: Failed to get TiKV PD endpoints"
              exit 1
            fi

            REDIS_ENDPOINT="${RedisCoordinator.PrivateIp}"
            # Extract IP from endpoint (format: IP:PORT)
            echo "Redis IP: $REDIS_ENDPOINT"

            # Test Redis connectivity
            for i in {1..30}; do
              if nc -zv $REDIS_ENDPOINT 6379 2>/dev/null; then
                echo "Redis is reachable"
                break
              fi
              echo "Waiting for Redis... attempt $i of 30"
              sleep 5
            done

            # Config download with retry loop (20 minutes max)
            CONFIG_URL="https://${ConfigBucket}.s3.${AWS::Region}.amazonaws.com/config.json"
            MAX_WAIT_SECONDS=1200  # 20 minutes
            RETRY_INTERVAL=10      # 10 seconds between retries
            ELAPSED=0
            CONFIG_DOWNLOADED=false
            TMP_CONFIG_PATH="/tmp/config.json"

            echo "=========================================="
            echo "Config Download - Retry Loop Started"
            echo "=========================================="
            echo "URL: $CONFIG_URL"
            echo "Target: /tmp/config.json"
            echo "Max wait time: $MAX_WAIT_SECONDS seconds (20 minutes)"
            echo "Retry interval: $RETRY_INTERVAL seconds"
            echo "=========================================="

            while [ $ELAPSED -lt $MAX_WAIT_SECONDS ]; do
                ATTEMPT=$((ELAPSED / RETRY_INTERVAL + 1))
                echo "[Attempt $ATTEMPT at $ELAPSED s] Downloading config..."

                if curl -f -s -m 10 -o $TMP_CONFIG_PATH "$CONFIG_URL" 2>&1; then
                  # Verify it's valid JSON
                  if jq empty $TMP_CONFIG_PATH 2>/dev/null; then
                    echo "✓ Config downloaded successfully!"
                    CONFIG_DOWNLOADED=true
                    break
                  else
                    echo "✗ Downloaded file is not valid JSON, retrying..."
                    rm -f $TMP_CONFIG_PATH
                  fi
                else
                  echo "✗ Download failed, retrying in $RETRY_INTERVAL s..."
                fi

                sleep $RETRY_INTERVAL
                ELAPSED=$((ELAPSED + RETRY_INTERVAL))
            done

            # If download failed, check for bundled config
            if [ "$CONFIG_DOWNLOADED" = false ]; then
                echo "ERROR: Failed to download config after 20 minutes"
                echo "Cannot start without configuration"
                exit 1
            fi

            # Create mount directory and copy config
            mkdir -p /psy-node
            cp $TMP_CONFIG_PATH /psy-node/config.json
            chmod 644 /psy-node/config.json

            echo "Config ready at /psy-node/config.json"
            echo "First 20 lines:"
            head -20 /psy-node/config.json

            # Run coordinator processor with json-file logging
            # CloudWatch agent will collect these logs automatically
            docker run -d --name coordinator-processor \
              --restart=unless-stopped \
              --log-driver=json-file \
              --log-opt max-size=100m \
              --log-opt max-file=5 \
              -v /psy-node/config.json:/psy-node/config.json:ro \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints "$PD_ENDPOINTS" \
              --tikv-namespace {{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator \
              --redis-uri "redis://$REDIS_ENDPOINT:6379" \
              --config-path /psy-node/config.json \
              {% for key, value in (config.nodes.coordinator.processor.args | default({}) | dictsort) %}
              {% if key != 'config_path' %}
              --{{ key | replace('_','-') }} '{{ value | string }}' \
              {% endif %}
              {% endfor %}

            # Verify container started
            sleep 5
            if docker ps | grep -q coordinator-processor; then
              echo "SUCCESS: Coordinator processor is running"
              docker logs coordinator-processor --tail 50
            else
              echo "ERROR: Coordinator processor failed to start"
              docker logs coordinator-processor 2>&1 || true
            fi

            # Create a systemd service to ensure coordinator starts on reboot
            cat > /etc/systemd/system/coordinator-processor.service <<EOF
            [Unit]
            Description=Psy Coordinator Processor
            After=docker.service
            Requires=docker.service

            [Service]
            Type=simple
            Restart=always
            RestartSec=10
            ExecStartPre=/usr/bin/docker pull ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest
            ExecStart=/usr/bin/docker run --rm --name coordinator-processor \
              --log-driver=json-file \
              --log-opt max-size=100m \
              --log-opt max-file=5 \
              -e RUST_LOG='{{ config.nodes.coordinator.processor.env.RUST_LOG }}' \
              ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest \
              coordinator-processor \
              --database tikv \
              --tikv-pd-endpoints "$PD_ENDPOINTS" \
              --tikv-namespace {{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator \
              --redis-uri "redis://$REDIS_ENDPOINT:6379" \
              --config-path /psy-node/config.json
            ExecStop=/usr/bin/docker stop coordinator-processor

            [Install]
            WantedBy=multi-user.target
            EOF

            systemctl daemon-reload
            systemctl enable coordinator-processor

            echo "Setup completed at $(date)"

  CoordinatorProcessorASG:
    Type: AWS::AutoScaling::AutoScalingGroup
    Properties:
      AutoScalingGroupName: !Sub '${ProjectName}-${Environment}-coordinator-processor-asg'
      LaunchTemplate:
        LaunchTemplateId: !Ref CoordinatorProcessorLaunchTemplate
        Version: !GetAtt CoordinatorProcessorLaunchTemplate.LatestVersionNumber
      MinSize: {{ config.nodes.coordinator.processor.aws.ec2.min_instances | default(1) }}
      MaxSize: {{ config.nodes.coordinator.processor.aws.ec2.max_instances | default(3) }}
      DesiredCapacity: {{ config.nodes.coordinator.processor.aws.ec2.desired_instances | default(1) }}
      VPCZoneIdentifier:
        - !Ref CoordinatorSubnet
      HealthCheckType: EC2
      HealthCheckGracePeriod: 300
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-coordinator-processor'
          PropagateAtLaunch: true
        - Key: Service
          Value: coordinator-processor
          PropagateAtLaunch: true

  # ============================================================================
  # ECS CONTAINER INSTANCES (EC2 DEPLOYMENT) - ASG for general ECS tasks , 
  # (Coordinator Edge, Realm Processor/Realm Edge, Watcher, Api services)
  # ============================================================================

  # ECS Container Instances for Edge, Worker, and API services
  GeneralECSInstancesLaunchTemplate:
    Type: AWS::EC2::LaunchTemplate
    Properties:
      LaunchTemplateName: !Sub '${ProjectName}-${Environment}-ecs-container-lt'
      LaunchTemplateData:
        ImageId: !Ref LatestAmiId
        InstanceType: c6i.2xlarge  # 8 vCPUs, 16GB RAM
        IamInstanceProfile:
          Name: !Ref EC2InstanceProfile
        SecurityGroupIds:
          - !Ref ECSSecurityGroup
        BlockDeviceMappings:
          - DeviceName: /dev/xvda
            Ebs:
              VolumeSize: 100
              VolumeType: gp3
              DeleteOnTermination: true
        TagSpecifications:
          - ResourceType: instance
            Tags:
              - Key: Name
                Value: !Sub '${ProjectName}-${Environment}-ecs-container'
              - Key: Service
                Value: ecs-container
        UserData:
          Fn::Base64: !Sub |
            #!/bin/bash
            set -e
            exec > /var/log/user-data.log 2>&1
            echo "Starting ECS instance setup at $(date)"
            
            # Update and install dependencies
            apt-get update -y
            apt-get install -y docker.io curl wget jq awscli ec2-instance-connect vim net-tools
            systemctl enable docker
            systemctl start docker
            usermod -aG docker ubuntu

            # Create ECS directories
            mkdir -p /etc/ecs /var/log/ecs /var/lib/ecs/data

            # Pull ECS agent image
            docker pull amazon/amazon-ecs-agent:latest

            # Run ECS agent using Docker
            docker run -d \
              --name ecs-agent \
              --restart=always \
              --volume=/var/run/docker.sock:/var/run/docker.sock \
              --volume=/var/log/ecs:/log \
              --volume=/var/lib/ecs/data:/data \
              --volume=/etc/ecs:/etc/ecs \
              --volume=/sys/fs/cgroup:/sys/fs/cgroup:ro \
              --net=host \
              --env=ECS_CLUSTER=${MainECSCluster} \
              --env=ECS_ENABLE_TASK_IAM_ROLE=true \
              --env=ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true \
              --env=ECS_ENABLE_CONTAINER_METADATA=true \
              --env=ECS_LOGFILE=/log/ecs-agent.log \
              --env=ECS_DATADIR=/data \
              --env=ECS_LOGLEVEL=info \
              --env='ECS_AVAILABLE_LOGGING_DRIVERS=["json-file","awslogs"]' \
              --env=ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true \
              --env=ECS_CONTAINER_STOP_TIMEOUT=30s \
              --env='ECS_INSTANCE_ATTRIBUTES={"workload":"general","type":"ecs-container"}' \
              --env=AWS_REGION=${AWS::Region} \
              amazon/amazon-ecs-agent:latest
            
            # Create systemd service for ECS agent to survive reboots
            cat > /etc/systemd/system/ecs-agent.service <<'EOF'
            [Unit]
            Description=AWS ECS Agent
            After=docker.service
            Requires=docker.service

            [Service]
            Type=simple
            Restart=always
            RestartSec=10
            ExecStartPre=-/usr/bin/docker stop ecs-agent
            ExecStartPre=-/usr/bin/docker rm ecs-agent
            ExecStart=/usr/bin/docker run --name ecs-agent \
              --volume=/var/run/docker.sock:/var/run/docker.sock \
              --volume=/var/log/ecs:/log \
              --volume=/var/lib/ecs/data:/data \
              --volume=/etc/ecs:/etc/ecs \
              --volume=/sys/fs/cgroup:/sys/fs/cgroup:ro \
              --net=host \
              --env=ECS_CLUSTER=${MainECSCluster} \
              --env=ECS_ENABLE_TASK_IAM_ROLE=true \
              --env=ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true \
              --env=ECS_ENABLE_CONTAINER_METADATA=true \
              --env=ECS_LOGFILE=/log/ecs-agent.log \
              --env=ECS_DATADIR=/data \
              --env=ECS_LOGLEVEL=info \
              --env='ECS_AVAILABLE_LOGGING_DRIVERS=["json-file","awslogs"]' \
              --env=ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true \
              --env=ECS_CONTAINER_STOP_TIMEOUT=30s \
              --env='ECS_INSTANCE_ATTRIBUTES={"workload":"general","type":"ecs-container"}' \
              --env=AWS_REGION=${AWS::Region} \
              amazon/amazon-ecs-agent:latest
            ExecStop=/usr/bin/docker stop ecs-agent

            [Install]
            WantedBy=multi-user.target
            EOF

            systemctl daemon-reload
            systemctl enable ecs-agent

            # Config download with retry loop (20 minutes max)
            CONFIG_URL="https://${ConfigBucket}.s3.${AWS::Region}.amazonaws.com/config.json"
            MAX_WAIT_SECONDS=1200  # 20 minutes
            RETRY_INTERVAL=10      # 10 seconds between retries
            ELAPSED=0
            CONFIG_DOWNLOADED=false
            TMP_CONFIG_PATH="/tmp/config.json"

            echo "=========================================="
            echo "Config Download - Retry Loop Started"
            echo "=========================================="
            echo "URL: $CONFIG_URL"
            echo "Target: /tmp/config.json"
            echo "Max wait time: $MAX_WAIT_SECONDS seconds (20 minutes)"
            echo "Retry interval: $RETRY_INTERVAL seconds"
            echo "=========================================="

            while [ $ELAPSED -lt $MAX_WAIT_SECONDS ]; do
                ATTEMPT=$((ELAPSED / RETRY_INTERVAL + 1))
                echo "[Attempt $ATTEMPT at $ELAPSED s] Downloading config..."

                if curl -f -s -m 10 -o $TMP_CONFIG_PATH "$CONFIG_URL" 2>&1; then
                  # Verify it's valid JSON
                  if jq empty $TMP_CONFIG_PATH 2>/dev/null; then
                    echo "✓ Config downloaded successfully!"
                    CONFIG_DOWNLOADED=true
                    break
                  else
                    echo "✗ Downloaded file is not valid JSON, retrying..."
                    rm -f $TMP_CONFIG_PATH
                  fi
                else
                  echo "✗ Download failed, retrying in $RETRY_INTERVAL s..."
                fi

                sleep $RETRY_INTERVAL
                ELAPSED=$((ELAPSED + RETRY_INTERVAL))
            done

            # If download failed, check for bundled config
            if [ "$CONFIG_DOWNLOADED" = false ]; then
                echo "ERROR: Failed to download config after 20 minutes"
                echo "Cannot start without configuration"
                exit 1
            fi

            # Create mount directory and copy config
            mkdir -p /psy-node
            cp $TMP_CONFIG_PATH /psy-node/config.json
            chmod 644 /psy-node/config.json

            echo "Config ready at /psy-node/config.json"
            echo "First 20 lines:"
            head -20 /psy-node/config.json

            # Create config sync script
            cat > /usr/local/bin/sync-config.sh <<'SYNC_SCRIPT'
            #!/bin/bash

            CONFIG_URL="https://${ConfigBucket}.s3.${AWS::Region}.amazonaws.com/config.json"
            LOCAL_CONFIG="/psy-node/config.json"
            TMP_CONFIG="/tmp/config_new.json"
            BACKUP_CONFIG="/psy-node/config.json.backup"

            echo "[$(date)] Starting config sync check..."

            # Download to temp location
            if curl -f -s -m 30 -o "$TMP_CONFIG" "$CONFIG_URL"; then
                # Verify it's valid JSON
                if jq empty "$TMP_CONFIG" 2>/dev/null; then
                # Compare with existing config
                    if [ -f "$LOCAL_CONFIG" ]; then
                        if ! cmp -s "$TMP_CONFIG" "$LOCAL_CONFIG"; then
                            echo "[$(date)] Config changed, updating..."

                            # Backup current config
                            cp "$LOCAL_CONFIG" "$BACKUP_CONFIG"

                            # Update config atomically
                            cp "$TMP_CONFIG" "$LOCAL_CONFIG"
                            chmod 644 "$LOCAL_CONFIG"

                            echo "[$(date)] Config updated successfully"
                        else
                            echo "[$(date)] Config unchanged"
                            rm -f "$TMP_CONFIG"
                        fi
                    else
                        # First time, just copy
                        cp "$TMP_CONFIG" "$LOCAL_CONFIG"
                        chmod 644 "$LOCAL_CONFIG"
                        echo "[$(date)] Initial config installed"
                    fi
                else
                    echo "[$(date)] ERROR: Downloaded config is not valid JSON"
                    rm -f "$TMP_CONFIG"
                    fi
            else
                echo "[$(date)] ERROR: Failed to download config from S3"
            fi

            echo "[$(date)] Config sync check completed"
            SYNC_SCRIPT
            # Make script executable
            chmod +x /usr/local/bin/sync-config.sh

            # Replace variables in the script
            sed -i "s|\${ConfigBucket}|${ConfigBucket}|g" /usr/local/bin/sync-config.sh
            sed -i "s|\${AWS::Region}|${AWS::Region}|g" /usr/local/bin/sync-config.sh

            # Create systemd timer for periodic sync (every 5 minutes)
            cat > /etc/systemd/system/sync-config.service <<'EOF'
            [Unit]
            Description=Sync Psy config from S3
            After=network-online.target
            Wants=network-online.target

            [Service]
            Type=oneshot
            ExecStart=/usr/local/bin/sync-config.sh
            StandardOutput=journal
            StandardError=journal
            EOF

            cat > /etc/systemd/system/sync-config.timer <<'EOF'
            [Unit]
            Description=Run config sync every 5 minutes
            Requires=sync-config.service

            [Timer]
            OnBootSec=5min
            OnUnitActiveSec=5min
            Unit=sync-config.service

            [Install]
            WantedBy=timers.target
            EOF

            # Enable and start the timer
            systemctl daemon-reload
            systemctl enable sync-config.timer
            systemctl start sync-config.timer

            echo "Config sync timer installed and started"

            # Run initial sync
            /usr/local/bin/sync-config.sh

            # Add log rotation for sync logs
            cat > /etc/logrotate.d/sync-config <<'EOF'
            /var/log/sync-config.log {
                daily
                rotate 7
                compress
                delaycompress
                missingok
                notifempty
                create 644 root root
            }
            EOF

            # Verify ECS agent started
            for i in {1..60}; do
              if docker ps | grep -q ecs-agent; then
                echo "ECS agent container is running"
                # Check logs for successful registration
                if docker logs ecs-agent 2>&1 | grep -q "Successfully registered container instance"; then
                  echo "Instance registered with ECS cluster"
                  break
                fi
              fi
              echo "Waiting for ECS agent... attempt $i/60"
              sleep 5
            done
            
            echo "ECS instance setup completed at $(date)"


