  # ============================================================================
  # TIMESCALEDB
  # ============================================================================
  {% if has_api_service %}
  # Database Security Group for TimescaleDB
  TimescaleDBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for TimescaleDB RDS instance
      VpcId: !Ref VPC
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 22
          ToPort: 22
          CidrIp: 0.0.0.0/0
          Description: SSH access
        - IpProtocol: tcp
          FromPort: 5432
          ToPort: 5432
          SourceSecurityGroupId: !Ref ECSSecurityGroup
          Description: Allow PostgreSQL access from ECS
        - IpProtocol: tcp
          FromPort: 3000
          ToPort: 3000
          CidrIp: 0.0.0.0/0
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb-sg'

  # Allow API service internal access
  ECSAPIServiceIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref ECSSecurityGroup
      IpProtocol: tcp
      FromPort: 3000
      ToPort: 3000
      SourceSecurityGroupId: !Ref ECSSecurityGroup
      Description: API Service internal access

  # Allow telemetry from all services
  ECSTelemetryIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref ECSSecurityGroup
      IpProtocol: tcp
      FromPort: 3000
      ToPort: 3000
      CidrIp: !GetAtt VPC.CidrBlock
      Description: Telemetry events to API service

  WatcherToAPIIngress:
    Type: AWS::EC2::SecurityGroupIngress
    Properties:
      GroupId: !Ref TimescaleDBSecurityGroup
      IpProtocol: tcp
      FromPort: 3000
      ToPort: 3000
      SourceSecurityGroupId: !Ref ECSSecurityGroup
      Description: Watcher access to API Service

  TimescaleDBInstance:
    Type: AWS::EC2::Instance
    Properties:
      InstanceType: c5.2xlarge  # 8 vCPU, 16GB RAM
      ImageId: !Ref LatestAmiId
      IamInstanceProfile: !Ref EC2InstanceProfile
      NetworkInterfaces:
        - DeviceIndex: 0
          AssociatePublicIpAddress: true
          DeleteOnTermination: true
          SubnetId: !Select
            - 0
            - !Split
              - ','
              - !Join
                - ','
                - - !Ref CoordinatorSubnet
                  - !Ref Realm0Subnet
                  - !Ref Realm1Subnet
          GroupSet:
            - !Ref TimescaleDBSecurityGroup
      BlockDeviceMappings:
        - DeviceName: /dev/sda1
          Ebs:
            VolumeSize: 50
            VolumeType: gp3
        - DeviceName: /dev/sdf  # Data volume  nvme0n1, nvme1n1
          Ebs:
            VolumeSize: 200  # Adjust based on your data needs
            VolumeType: gp3
            DeleteOnTermination: true  # Preserve data , when in production, change to false
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-timescaledb'
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          set -e
          exec > /var/log/user-data.log 2>&1
          
          echo "Starting TimescaleDB + API Service setup at $(date)"
          
          # Install Docker and dependencies
          apt-get update -y
          apt-get install -y docker.io docker-compose awscli jq postgresql-client
          systemctl enable docker
          systemctl start docker
          
          # Configure AWS region
          export AWS_DEFAULT_REGION=${AWS::Region}

          # Setup data volume - FIXED detection logic
          echo "Setting up data volume..."

          # Get root device info
          ROOT_DEVICE=$(findmnt -n -o SOURCE / | sed 's/\[.*\]//' | sed 's/p[0-9]*$//')
          ROOT_SIZE=$(lsblk -bdn -o SIZE "$ROOT_DEVICE")

          echo "Root device: $ROOT_DEVICE (size: $ROOT_SIZE bytes)"
          lsblk -o NAME,SIZE,TYPE,MOUNTPOINT

          # Find data volume (non-root, larger than 100GB)
          root_name=$(echo "$ROOT_DEVICE" | sed 's|/dev/||')
          DATA_DEVICE=$(lsblk -ndo NAME,SIZE,TYPE -b | \
            awk -v root="$root_name" -v root_size="$ROOT_SIZE" \
            '$3 == "disk" && $1 != root && $2 != root_size && $2 > 107374182400 {print "/dev/"$1; exit}')
          
          if [ -z "$DATA_DEVICE" ]; then
            echo "ERROR: Could not find data volume (>100GB)"
            lsblk -o NAME,SIZE,TYPE,MOUNTPOINT
            exit 1
          fi
          
          echo "Data device identified: $DATA_DEVICE"

          # Mount data volume
          if ! mountpoint -q /data; then
            # Check if already formatted
            if ! blkid "$DATA_DEVICE" | grep -q "TYPE="; then
              echo "Formatting $DATA_DEVICE..."
              mkfs.ext4 -F -L timescaledb_data "$DATA_DEVICE"
            else
              echo "Device already formatted"
            fi

            mkdir -p /data
            if ! grep -q "$DATA_DEVICE" /etc/fstab; then
              echo "$DATA_DEVICE /data ext4 defaults,nofail 0 2" >> /etc/fstab
            fi
            mount -a
          else
            echo "/data already mounted"
          fi

          # Verify mount
          if ! mountpoint -q /data; then
            echo "ERROR: Failed to mount /data"
            exit 1
          fi

          echo "Data volume mounted successfully:"
          df -h /data

          # Create directories with proper permissions
          mkdir -p /data/timescaledb /data/api-service
          chown -R 999:999 /data/timescaledb  # PostgreSQL user
          chmod 700 /data/timescaledb
          chmod 755 /data/api-service

          # Retrieve password from Secrets Manager
          echo "Retrieving database password from Secrets Manager..."

          DB_PASSWORD="7MvqPqWzKYTbWbE8vwc2trRpp" # default for testing, replace with actual retrieval in production

          # Create docker-compose for TimescaleDB + API Service
          cat > /opt/docker-compose.yml <<'COMPOSE_EOF'
          version: '3.8'

          networks:
            psy-network:
              driver: bridge

          services:
            timescaledb:
              image: timescale/timescaledb:latest-pg17
              container_name: timescaledb
              restart: unless-stopped
              environment:
                POSTGRES_PASSWORD: DB_PASSWORD_PLACEHOLDER
                POSTGRES_DB: psy
                POSTGRES_INITDB_ARGS: "--encoding=UTF8 --lc-collate=en_US.utf8 --lc-ctype=en_US.utf8"
              ports:
                - "5432:5432"
              volumes:
                - /data/timescaledb:/var/lib/postgresql/data
              healthcheck:
                test: ["CMD-SHELL", "pg_isready -U postgres"]
                interval: 10s
                timeout: 5s
                retries: 5
              networks:
                - psy-network

            api-service:
              image: ECR_URI_PLACEHOLDER
              container_name: api-service
              restart: unless-stopped
              depends_on:
                timescaledb:
                  condition: service_healthy
              ports:
                - "3000:3000"
              environment:
                DATABASE_URL: DATABASE_URL_PLACEHOLDER
                RUST_LOG: RUST_LOG_PLACEHOLDER
                AWS_DEFAULT_REGION: AWS_REGION_PLACEHOLDER
              command:
                - api-services
                - --database-url=postgresql://postgres:DB_PASSWORD_PLACEHOLDER@timescaledb:5432/psy
              healthcheck:
                test: ["CMD-SHELL", "nc -z 127.0.0.1 3000 || exit 1"]
                interval: 30s
                timeout: 5s
                retries: 3
                start_period: 60s
              networks:
                - psy-network
              logging:
                driver: json-file
                options:
                  max-size: "100m"
                  max-file: "5"
          COMPOSE_EOF

          # Function to safely replace placeholders
          replace_placeholder() {
              local placeholder="$1"
              local value="$2"
              local file="$3"

              # Escape special characters for sed
              local escaped_value
              escaped_value=$(printf '%s\n' "$value" | sed 's/[[\.*^$()+?{|]/\\&/g')

              echo "[INFO] Replacing $placeholder in $file..."
              if ! sed -i "s|$placeholder|$escaped_value|g" "$file"; then
                  echo "[ERROR] sed replacement failed for $placeholder"
                  cat "$file"
                  exit 1
              fi
          }

          # Build the database URL
          DATABASE_URL="postgresql://postgres:$DB_PASSWORD@timescaledb:5432/psy"
          ECR_URI="${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}:latest"
          RUST_LOG="{{ config.global_api_services.api_service.env.RUST_LOG | default('info') }}"

          # Replace all placeholders
          replace_placeholder "DB_PASSWORD_PLACEHOLDER" "$DB_PASSWORD" /opt/docker-compose.yml
          replace_placeholder "ECR_URI_PLACEHOLDER" "$ECR_URI" /opt/docker-compose.yml
          replace_placeholder "DATABASE_URL_PLACEHOLDER" "$DATABASE_URL" /opt/docker-compose.yml
          replace_placeholder "RUST_LOG_PLACEHOLDER" "$RUST_LOG" /opt/docker-compose.yml
          replace_placeholder "AWS_REGION_PLACEHOLDER" "${AWS::Region}" /opt/docker-compose.yml

          echo "[INFO] Final docker-compose.yml:"
          echo "==========================================="
          # Show config but mask the password
          cat /opt/docker-compose.yml | sed "s|$DB_PASSWORD|***MASKED***|g"
          echo "==========================================="

          # Login to ECR
          aws ecr get-login-password --region ${AWS::Region} | \
            docker login --username AWS --password-stdin \
            ${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com

          docker pull "$ECR_URI"

          # Start services
          cd /opt
          docker-compose up -d

          # Wait for TimescaleDB to be ready
          echo "Waiting for TimescaleDB to be ready..."
          for i in $(seq 1 120); do
            if docker exec timescaledb pg_isready -U postgres > /dev/null 2>&1; then
              echo "TimescaleDB is ready!"

              # Create TimescaleDB extension
              docker exec api-service sh -c "cd /psy-node/psy_services && sqlx migrate run" || {
                echo "Migration status:"
                docker logs api-service --tail 20
              }
              break
            fi
            echo "Waiting for PostgreSQL... attempt $i/60"
            sleep 5
          done

          # Run migrations (assumes your image has migrations)
          echo "Running database migrations..."
          docker exec api-service /bin/bash -c "cd /psy-node && export DATABASE_URL=postgresql://postgres:$DB_PASSWORD@timescaledb:5432/psy && /usr/local/bin/sqlx database create || true && /usr/local/bin/sqlx migrate run" || true
          echo "Setup completed at $(date)"

  {% endif %}

Outputs:
  VPCId:
    Value: !Ref VPC
    Export:
      Name: !Sub '${ProjectName}-${Environment}-vpc-id'

  MainECSClusterName:
    Value: !Ref MainECSCluster
    Export:
      Name: !Sub '${ProjectName}-${Environment}-main-ecs-cluster'

  ALBDNSName:
    Value: !GetAtt ApplicationLoadBalancer.DNSName
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-dns'
    Description: Application Load Balancer DNS name

  ECRRepositoryURI:
    Value: !Sub '${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ config.nodes.deployment.aws.ecr.repository_name }}'
    Export:
      Name: !Sub '${ProjectName}-${Environment}-ecr-uri'

  ServiceDiscoveryNamespaceId:
    Value: !Ref ServiceDiscoveryNamespace
    Export:
      Name: !Sub '${ProjectName}-${Environment}-sd-namespace-id'

  TaskExecutionRoleArn:
    Value: !GetAtt ECSTaskExecutionRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-execution-role'

  TaskRoleArn:
    Value: !GetAtt ECSTaskRole.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-task-role'

  # ALB Target Group ARNs
  ALBTargetGroupCoordinatorArn:
    Value: !Ref ALBTargetGroupCoordinator
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-tg-coordinator'

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Value: !Ref ALBTargetGroupRealm{{ realm.id }}
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-tg-realm-{{ realm.id }}'
  {% endfor %}

  ALBTargetGroupProverArn:
    Value: !Ref ALBTargetGroupProver
    Export:
      Name: !Sub '${ProjectName}-${Environment}-alb-tg-prover'
    Description: ALB Target Group ARN for Prover service

  # Redis Endpoints
  RedisCoordinatorEndpoint:
    Value: !GetAtt RedisCoordinator.PrivateIp
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-coordinator-endpoint'
    Description: Redis Coordinator endpoint

  {% for realm in config.nodes.realms %}
  RedisRealm{{ realm.id }}Endpoint:
    Value: !GetAtt RedisRealm{{ realm.id }}.PrivateIp
    Export:
      Name: !Sub '${ProjectName}-${Environment}-redis-realm-{{ realm.id }}-endpoint'
    Description: Redis Realm {{ realm.id }} endpoint
  {% endfor %}

  # This belongs in main.yaml, not ecs-services.yaml
  {% if uses_tikv_global %}
  TiKVPDAutoScalingGroupName:
    Description: TiKV PD Auto Scaling Group name
    Value: !Ref TiKVPDAutoScalingGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-pd-asg-name'
  {% endif %}

  {% if has_api_service %}
  APIServiceEndpoint:
    Value: !GetAtt TimescaleDBInstance.PrivateIp
    Export:
      Name: !Sub '${ProjectName}-${Environment}-timescaledb-ip'
  {% endif %}

  {% if uses_tikv_global %}
  TiKVSecurityGroupId:
    Value: !Ref TiKVSecurityGroup
    Export:
      Name: !Sub '${ProjectName}-${Environment}-tikv-sg'
  {% endif %}

  # Subnet IDs
  CoordinatorSubnetId:
    Value: !Ref CoordinatorSubnet
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-subnet'

  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}SubnetId:
    Value: !Ref Realm{{ realm.id }}Subnet
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-subnet'
  {% endfor %}

  ConfigBucketName:
    Description: Name of the config S3 bucket
    Value: !Ref ConfigBucket
    Export:
      Name: !Sub '${ProjectName}-${Environment}-config-bucket-name'

