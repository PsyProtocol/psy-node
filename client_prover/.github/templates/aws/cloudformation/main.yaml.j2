      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-tikv-node'
          PropagateAtLaunch: true
        - Key: Component
          Value: tikv
          PropagateAtLaunch: true
  {% endif %}


  # ============================================================================
  # Redis Configuration (using EC2 instances for CONFIG command support)
  # ============================================================================

  # Coordinator Redis EC2 Instance
  RedisCoordinator:
    Type: AWS::EC2::Instance
    Properties:
      ImageId: !Ref LatestAmiId
      InstanceType: c5.xlarge  # 4 vCPU, 8 GB RAM
      SubnetId: !Ref CoordinatorSubnet
      SecurityGroupIds:
        - !Ref CoordinatorRedisSecurityGroup
      IamInstanceProfile: !Ref EC2InstanceProfile
      UserData:
        Fn::Base64: !Sub |
          #!/bin/bash
          set -e
          exec > /var/log/user-data.log 2>&1

          apt-get update
          apt-get install -y redis-server awscli net-tools

          cp /etc/redis/redis.conf /etc/redis/redis.conf.orig
          
          # Configure Redis for Psy
          cat > /etc/redis/redis.conf <<EOF
          # Network
          bind 0.0.0.0
          port 6379
          protected-mode no
          tcp-backlog 511
          timeout 0
          tcp-keepalive 300

          # General
          daemonize yes
          save 900 1
          save 300 10
          save 60 10000
          rdbcompression yes
          dbfilename dump.rdb
          dir /var/lib/redis
          maxmemory 6gb
          maxmemory-policy allkeys-lru
          notify-keyspace-events Ex
          EOF
          
          systemctl enable redis-server
          systemctl start redis-server
          
          # Add health check verification
          sleep 5
          if ! redis-cli ping | grep -q PONG; then
            echo "ERROR: Redis failed to start"
            exit 1
          fi

          # Wait for Redis to start
          sleep 5
          
          # Test Redis is working
          redis-cli ping

          # Store Redis endpoint in SSM Parameter Store
          INSTANCE_IP=$(curl -s http://169.254.169.254/latest/meta-data/local-ipv4)
          echo "Instance IP: $INSTANCE_IP"

          echo "Restart Redis to apply configuration"
          systemctl restart redis-server
          sleep 5

          if ! redis-cli -h $INSTANCE_IP ping | grep -q PONG; then
            echo "ERROR: Redis failed to start"
            exit 1
          fi

          aws ssm put-parameter \
            --name "/${ProjectName}/redis/coordinator/endpoint" \
            --value "$INSTANCE_IP:6379" \
            --type "String" \
            --overwrite \
            --region ${AWS::Region} || echo "Coordinator Redis SSM parameter failed"
      Tags:
        - Key: Name
          Value: !Sub '${ProjectName}-${Environment}-redis-coordinator'

