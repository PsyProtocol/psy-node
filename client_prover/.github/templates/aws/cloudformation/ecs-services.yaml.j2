---
AWSTemplateFormatVersion: '2010-09-09'
Description: 'Psy Protocol ECS Services - Edge, Worker, Watcher, and API Services'

Parameters:
  ProjectName:
    Type: String
    Default: {{ config.nodes.deployment.aws.project_name }}

  Environment:
    Type: String
    Default: dev

  MainECSClusterName:
    Type: String
    Description: Main ECS Cluster name from main stack

  ECRRepositoryURI:
    Type: String
    Description: ECR Repository URI from main stack

  ALBTargetGroupCoordinatorArn:
    Type: String
    Description: ALB Target Group ARN for Coordinator

  {% for realm in config.nodes.realms %}
  ALBTargetGroupRealm{{ realm.id }}Arn:
    Type: String
    Description: ALB Target Group ARN for Realm {{ realm.id }}
  {% endfor %}

  ALBTargetGroupProverArn:
    Type: String
    Description: ALB Target Group ARN for Prover service

  TaskExecutionRoleArn:
    Type: String
    Description: ECS Task Execution Role ARN

  TaskRoleArn:
    Type: String
    Description: ECS Task Role ARN

  ServiceDiscoveryNamespaceId:
    Type: String
    Description: Service Discovery Namespace ID from main stack

  RedisCoordinatorEndpoint:
    Type: String
    Description: Redis Coordinator endpoint

  {% for realm in config.nodes.realms %}
  RedisRealm{{ realm.id }}Endpoint:
    Type: String
    Description: Redis Realm {{ realm.id }} endpoint
  {% endfor %}

  ALBDNSName:
    Type: String
    Description: Application Load Balancer DNS name

  TiKVPDEndpoints:
    Type: String
    Description: Comma-separated list of TiKV PD endpoints
    Default: "127.0.0.1:2379"

  ConfigBucketName:
    Type: String
    Description: Name of the config S3 bucket
  
  # TimescaleDB Endpoint (if enabled)
  {% if config.global_api_services and config.global_api_services.timescaledb and config.global_api_services.timescaledb.enabled %}
  APIServiceEndpoint:
    Type: String
    Description: Private IP of TimescaleDB instance from main stack
  {% endif %}


Resources:
  # ============================================================================
  # Coordinator Edge Service
  # ============================================================================

  CoordinatorEdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: coordinator-data
          Host:
            SourcePath: /data/coordinator
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: coordinator-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            {% for key, value in (config.nodes.coordinator.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: RedisCoordinatorEndpoint
              Value: !Ref RedisCoordinatorEndpoint
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
          Memory: {{ config.nodes.coordinator.edge.aws.memory }}
          MemoryReservation: {{ (config.nodes.coordinator.edge.aws.memory * 0.75) | int }}
          Cpu: {{ config.nodes.coordinator.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: coordinator-data
              ContainerPath: /data
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          PortMappings:
            - ContainerPort: 8545
              HostPort: 8545
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -fs http://127.0.0.1:8545/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120  # Increased to allow time for PD discovery
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-edge
          Essential: true
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Get TiKV PD endpoints dynamically
              PD_ASG_NAME="${ProjectName}-${Environment}-tikv-pd-asg"
              PD_ENDPOINTS=""

              echo "Fetching TiKV PD endpoints..."
              for attempt in $(seq 1 30); do
                PD_INSTANCES=$(aws autoscaling describe-auto-scaling-groups \
                  --auto-scaling-group-names $PD_ASG_NAME \
                  --query 'AutoScalingGroups[0].Instances[?LifecycleState==`InService`].InstanceId' \
                  --output text \
                  --region ${AWS::Region} 2>/dev/null || echo "")
                
                if [ -n "$PD_INSTANCES" ]; then
                  for pd_id in $PD_INSTANCES; do
                    PD_IP=$(aws ec2 describe-instances \
                      --instance-ids $pd_id \
                      --query 'Reservations[0].Instances[0].PrivateIpAddress' \
                      --output text \
                      --region ${AWS::Region} 2>/dev/null || echo "")
                    
                    if [ -n "$PD_IP" ] && [ "$PD_IP" != "None" ]; then
                      if [ -z "$PD_ENDPOINTS" ]; then
                        PD_ENDPOINTS="$PD_IP:2379"
                      else
                        PD_ENDPOINTS="$PD_ENDPOINTS,$PD_IP:2379"
                      fi
                    fi
                  done
                  if [ -n "$PD_ENDPOINTS" ]; then
                    echo "Got PD endpoints: $PD_ENDPOINTS"
                    break
                  fi
                fi
                
                echo "Waiting for TiKV PD endpoints... attempt $attempt/30"
                sleep 5
              done

              if [ -z "$PD_ENDPOINTS" ]; then
                echo "ERROR: Could not get TiKV PD endpoints, using parameter default"
                PD_ENDPOINTS="${TiKVPDEndpoints}"
              fi

              # Start coordinator-edge
              exec /psy-node/psy_node_cli coordinator-edge \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator" \
                --redis-uri "redis://${RedisCoordinatorEndpoint}:6379" \
                {%- set args = (config.nodes.coordinator.edge.args | default({}) | dictsort) %}
                {%- if config.nodes.coordinator.edge.args is defined and 'listen_addr' in config.nodes.coordinator.edge.args %}
                --listen-addr "{{ config.nodes.coordinator.edge.args['listen_addr'] }}"{% if args|length > 1 or (args|length == 1 and args[0][0] != 'listen_addr') %} \{% endif %}
                {%- else %}
                --listen-addr "0.0.0.0:8545"{% if args|length > 0 %} \{% endif %}
                {%- endif %}
                {%- for key, value in args %}
                  {%- if key != 'listen_addr' %}
                  --{{ key | replace('_','-') }} "{{ value | string }}"{% if not loop.last %} \{% endif %}
                  {%- endif %}
                {%- endfor %}

  CoordinatorEdgeService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorEdgeTaskDefinition
      DesiredCount: {{ config.nodes.coordinator.edge.aws.ecs.task_count | default(1) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      LoadBalancers:
        - ContainerName: coordinator-edge
          ContainerPort: 8545
          TargetGroupArn: !Ref ALBTargetGroupCoordinatorArn
      HealthCheckGracePeriodSeconds: 120
      ServiceRegistries:
        - RegistryArn: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
          ContainerName: coordinator-edge
          ContainerPort: 8545


  CoordinatorEdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: coordinator-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  CoordinatorEdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ config.nodes.coordinator.edge.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${CoordinatorEdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  CoordinatorEdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-coordinator-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref CoordinatorEdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0

  # ============================================================================
  # REALM PROCESSOR ECS SERVICES
  # ============================================================================
    
  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Processor Service
  Realm{{ realm.id }}ProcessorTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: realm{{ realm.id }}-processor-data
          Host:
            SourcePath: /data/realm{{ realm.id }}-processor
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-processor
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            {% for key, value in (realm.processor.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region' 
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: RedisRealm{{ realm.id }}Endpoint
              Value: !Ref RedisRealm{{ realm.id }}Endpoint
          Memory: {{ realm.processor.aws.memory }}
          MemoryReservation: {{ (realm.processor.aws.memory * 0.75) | int }}
          Cpu: {{ realm.processor.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-processor-data
              ContainerPath: /data
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'pgrep -f "psy_node_cli.*realm-processor" || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-processor
          Essential: true 
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Get TiKV PD endpoints dynamically
              PD_ENDPOINTS="${TiKVPDEndpoints}" 

              # Get Redis endpoint for this realm 
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"
              
              echo "Starting Realm {{ realm.id }} Processor with Redis: $REDIS_ENDPOINT and TiKV: $PD_ENDPOINTS"


              {%- set extra_args = realm.processor.args | default({}) -%}
              {%- set loop_args = extra_args
                    | dictsort
                    | rejectattr('0','equalto','realm-id')
                    | rejectattr('0','equalto','queue-biz-key')
                    | rejectattr('0','equalto','database')
                    | rejectattr('0','equalto','tikv-pd-endpoints')
                    | rejectattr('0','equalto','tikv-namespace')
                    | rejectattr('0','equalto','redis-uri')
                    | list
                    | default([])
              -%}
              {%- set have_qbk = ('queue-biz-key' in extra_args) and extra_args['queue-biz-key'] is defined and extra_args['queue-biz-key'] != '' -%}
              
      
              # Print full realm-processor startup command for debugging
              echo "================= REALM PROCESSOR STARTUP ================="
              echo "Realm ID: {{ realm.id }}"
              echo "Database: tikv"
              echo "TiKV PD Endpoints: $PD_ENDPOINTS"
              echo "TiKV Namespace: {{ realm.backend.tikv.namespace }}"
              echo "Redis URI: redis://$REDIS_ENDPOINT:6379"
              {%- if have_qbk %}
              echo "Queue Biz Key: {{ extra_args['queue-biz-key'] }}"
              {%- endif %}
              {%- for key, value in loop_args %}
              echo "Extra Arg: --{{ key | replace('_','-') }} {{ value | string }}"
              {%- endfor %}
              echo "==========================================================="

              # Start realm processor
              exec /psy-node/psy_node_cli realm-processor \
                --realm-id {{ realm.id }} \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ realm.backend.tikv.namespace }}" \
                --redis-uri "redis://$REDIS_ENDPOINT:6379" \
                {%- if have_qbk %}
                --queue-biz-key "{{ extra_args['queue-biz-key'] }}"{% if loop_args|length > 0 %} \{% endif %}
                {%- endif %}
                {%- for key, value in loop_args %}
                --{{ key | replace('_','-') }} "{{ value | string }}"{% if not loop.last %} \{% endif %}
                {%- endfor %}


  Realm{{ realm.id }}ProcessorService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-processor'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}ProcessorTaskDefinition
      DesiredCount: 1  # Only one processor per realm
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      PlacementStrategies:
        - Type: spread
          Field: attribute:ecs.availability-zone
        - Type: spread
          Field: instanceId

  {% endfor %} 
  # ============================================================================
  # REALM EDGE SERVICES
  # ============================================================================

  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Edge Service
  Realm{{ realm.id }}EdgeTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: realm{{ realm.id }}-edge-data
          Host:
            SourcePath: /data/realm{{ realm.id }}-edge
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-edge
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            {% for key, value in (realm.edge.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: MainECSClusterName
              Value: !Ref MainECSClusterName
            - Name: RedisRealm{{ realm.id }}Endpoint
              Value: !Ref RedisRealm{{ realm.id }}Endpoint
            - Name: ALBDNSName
              Value: !Ref ALBDNSName
          Memory: {{ realm.edge.aws.memory }}
          MemoryReservation: {{ (realm.edge.aws.memory * 0.75) | int }}
          Cpu: {{ realm.edge.aws.cpu }}
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: realm{{ realm.id }}-edge-data
              ContainerPath: /data
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          PortMappings:
            - ContainerPort: {{ 8546 + realm.id }}
              HostPort: {{ 8546 + realm.id }}
              Protocol: tcp
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -fs http://127.0.0.1:{{ 8546 + realm.id }}/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 120
          Essential: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-edge-init
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Get TiKV PD endpoints dynamically
              PD_ENDPOINTS="${TiKVPDEndpoints}"

              # Get Redis endpoint for this realm
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"

              #Use the ALB endpoint directly instead of service discovery
              COORDINATOR_ADDR="http://${ALBDNSName}:8545"
              
              echo "Starting Realm {{ realm.id }} Edge"
              echo "  Coordinator: $COORDINATOR_ADDR"
              echo "  Redis: $REDIS_ENDPOINT"
              echo "  TiKV: $PD_ENDPOINTS"

              {% set listen_addr = (realm.edge.args['listen_addr'] if realm.edge.args is defined and 'listen_addr' in realm.edge.args else '0.0.0.0:' ~ (8546 + realm.id)) -%}
              # Start realm edge
              exec /psy-node/psy_node_cli realm-edge \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ realm.backend.tikv.namespace }}" \
                --redis-uri "redis://$REDIS_ENDPOINT:6379" \
                --realm-id {{ realm.id }} \
                --coordinator-addr "$COORDINATOR_ADDR" \
                --listen-addr "{{ listen_addr }}" \
                {% if realm.edge.args is defined and realm.edge.args['queue_biz_key'] -%}
                --queue-biz-key "{{ realm.edge.args['queue_biz_key'] }}" 
                {% endif %}
          

  Realm{{ realm.id }}EdgeService:
    Type: AWS::ECS::Service
    DependsOn: Realm{{ realm.id }}ProcessorService  # Ensure processor starts first
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}EdgeTaskDefinition
      DesiredCount: {{ realm.edge.aws.ecs.task_count | default(2) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      PlacementStrategies:
        - Type: spread
          Field: attribute:ecs.availability-zone
        - Type: spread
          Field: instanceId
      LoadBalancers:
        - ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ 8546 + realm.id }}
          TargetGroupArn: !Ref ALBTargetGroupRealm{{ realm.id }}Arn
      HealthCheckGracePeriodSeconds: 180
      ServiceRegistries:
        - RegistryArn: !GetAtt Realm{{ realm.id }}EdgeServiceDiscovery.Arn
          ContainerName: realm-{{ realm.id }}-edge
          ContainerPort: {{ 8546 + realm.id }}

  Realm{{ realm.id }}EdgeServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: realm-{{ realm.id }}-edge
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Realm {{ realm.id }} Edge
  Realm{{ realm.id }}EdgeScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 10
      MinCapacity: {{ realm.edge.aws.ecs.task_count | default(2) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${Realm{{ realm.id }}EdgeService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  Realm{{ realm.id }}EdgeScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref Realm{{ realm.id }}EdgeScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageMemoryUtilization
        TargetValue: 70.0  
  {% endfor %}
  
  # ============================================================================
  # WORKER SERVICES
  # ============================================================================
  {% if config.nodes.workers and config.nodes.workers.enabled %}

  WorkerTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-worker'
      NetworkMode: bridge
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.workers.aws.cpu }}'
      Memory: '{{ config.nodes.workers.aws.memory }}'
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: worker
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: COORDINATOR_URL
              Value: !Sub 'http://${ALBDNSName}:8545'
            {% for key, value in (config.nodes.workers.env | default({}) | dictsort) %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endfor %}
          Memory: {{ config.nodes.workers.aws.memory }}
          MemoryReservation: {{ (config.nodes.workers.aws.memory * 0.875) | int }}
          Cpu: {{ config.nodes.workers.aws.cpu }}
          Essential: true
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: worker
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Enable verbose debugging
              set -x
              # Config is now mounted, no need to download
              if [ ! -f /psy-node/config.json ]; then
                  echo "ERROR: config.json not found at /psy-node/config.json"
                  exit 1
              fi
              echo "Using mounted config.json from host"
              
              # Verify config structure for debugging
              if command -v jq &> /dev/null; then
                echo "============================================"
                echo "WORKER CONFIGURATION SECTION"
                echo "============================================"
                jq '.nodes.workers' /psy-node/config.json
                
                echo "============================================"
                echo "NETWORK CONFIGURATION"
                echo "============================================"
                jq '.network' /psy-node/config.json
              fi

              # Start worker with mounted config
              exec /psy-node/psy_node_cli worker \
                --config /psy-node/config.json \
                {%- for key, value in (config.nodes.workers.args | default({}) | dictsort) %}
                {%- if key != 'config' %}
                --{{ key | replace('_', '-') }} '{{ value }}'{% if not loop.last %} \{% endif %}
                {%- endif %}
                {%- endfor %}

  WorkerService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-worker'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref WorkerTaskDefinition
      DesiredCount: {{ config.nodes.workers.aws.ecs.task_count | default(3) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == worker'
      PlacementStrategies:
        - Type: spread
          Field: instanceId  
      DeploymentConfiguration:
        MaximumPercent: 100      # Don't over-provision
        MinimumHealthyPercent: 66  # Allow rolling updates 

  WorkerScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: 12  # Max 12 tasks 
      MinCapacity: {{ config.nodes.workers.aws.ecs.task_count }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${WorkerService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  WorkerScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-worker-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref WorkerScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 70.0
  {% endif %}

  # ============================================================================
  # PROVER SERVICE (if enabled)
  # ============================================================================
  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-prover'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      Cpu: '{{ config.nodes.prover.aws.cpu | default(8192) }}'  # 8 vCPUs
      Memory: '{{ config.nodes.prover.aws.memory | default(16384) }}'  # 16GB
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      ContainerDefinitions:
        - Name: prover
          Image: !Sub '${ECRRepositoryURI}:latest'
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - /psy-node/psy_user_cli prove-proxy
          Environment:
            - Name: RUST_LOG
              Value: '{{ config.nodes.prover.env.RUST_LOG | default("info") }}'
            - Name: PROVE_PROXY_LISTEN_ADDR
              Value: "0.0.0.0:9999"
            {% for key, value in (config.nodes.prover.env | default({}) | dictsort) %}
            {% if key not in ['PROVE_PROXY_LISTEN_ADDR'] %}
            - Name: {{ key }}
              Value: '{{ value | string }}'
            {% endif %}
            {% endfor %}
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'curl -fs http://127.0.0.1:9999/health || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          PortMappings:
            - ContainerPort: 9999
              HostPort: 9999
              Protocol: tcp
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: prover
          LinuxParameters:
            InitProcessEnabled: true
          Ulimits:
            - Name: nofile
              HardLimit: 65535
              SoftLimit: 65535
            - Name: nproc
              HardLimit: 32768
              SoftLimit: 32768

  # Prover Service with dedicated placement
  ProverService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-prover'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref ProverTaskDefinition
      DesiredCount: {{ config.nodes.prover.aws.ecs.task_count | default(2) }}
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == prover' 
      PlacementStrategies:
        - Type: spread
          Field: instanceId
        - Type: spread
          Field: attribute:ecs.availability-zone
      LoadBalancers:
        - ContainerName: prover
          ContainerPort: 9999
          TargetGroupArn: !Ref ALBTargetGroupProverArn
      HealthCheckGracePeriodSeconds: 120
      ServiceRegistries:
        - RegistryArn: !GetAtt ProverServiceDiscovery.Arn
          ContainerName: prover
          ContainerPort: 9999


  ProverServiceDiscovery:
    Type: AWS::ServiceDiscovery::Service
    Properties:
      Name: prover
      DnsConfig:
        DnsRecords:
          - Type: SRV
            TTL: 10
        NamespaceId: !Ref ServiceDiscoveryNamespaceId
      HealthCheckCustomConfig:
        FailureThreshold: 1

  # Auto Scaling for Prover
  ProverScalableTarget:
    Type: AWS::ApplicationAutoScaling::ScalableTarget
    Properties:
      MaxCapacity: {{ config.nodes.prover.aws.ecs.max_tasks | default(20) }}
      MinCapacity: {{ config.nodes.prover.aws.ecs.min_tasks | default(2) }}
      ResourceId: !Sub 'service/${MainECSClusterName}/${ProverService.Name}'
      RoleARN: !Sub 'arn:aws:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService'
      ScalableDimension: ecs:service:DesiredCount
      ServiceNamespace: ecs

  ProverCPUScalingPolicy:
    Type: AWS::ApplicationAutoScaling::ScalingPolicy
    Properties:
      PolicyName: !Sub '${ProjectName}-${Environment}-prover-cpu-scaling'
      PolicyType: TargetTrackingScaling
      ScalingTargetId: !Ref ProverScalableTarget
      TargetTrackingScalingPolicyConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ECSServiceAverageCPUUtilization
        TargetValue: 60.0  # Scale when CPU hits 60%
        ScaleInCooldown: 300  # 5 minutes
        ScaleOutCooldown: 60   # 1 minute
  {% endif %} 
  # ============================================================================
  # WATCHER SERVICES
  # ============================================================================
 
  # Coordinator Watcher Service
  CoordinatorWatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: coordinator-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: RedisCoordinatorEndpoint
              Value: !Ref RedisCoordinatorEndpoint
            - Name: CONFIG_BUCKET
              Value: !Ref ConfigBucketName
            - Name: API_ENDPOINT
              Value: !Ref APIServiceEndpoint
            - Name: REDIS_ENDPOINT
              Value: !Ref RedisCoordinatorEndpoint
          Memory: 2048  
          MemoryReservation: 1536  # 3GB reserved
          Cpu: 2048  # 2 vCPUs
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: coordinator-watcher
          Essential: true
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'pgrep -f "psy_node_cli.*watcher.*--node-type" || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Config is mounted, no need to download
              if [ ! -f /psy-node/config.json ]; then
                  echo "ERROR: config.json not found at /psy-node/config.json"
                  exit 1
              fi
            
              echo "Using mounted config.json from host"
              
              # Get TiKV PD endpoints
              PD_ENDPOINTS="${TiKVPDEndpoints}"
              
              # API endpoint resolution options:
              if [ -n "${APIServiceEndpoint}" ]; then
                  API_URL="${APIServiceEndpoint}"
                  echo "Using APIServiceEndpoint from environment: $API_URL"
              elif [ -n "${ALBDNSName}" ]; then
                  API_URL="http://${ALBDNSName}:3000"
                  echo "Using ALB DNS for API: $API_URL"
              else
                  API_URL="http://${APIServiceEndpoint}:3000"
              fi
              
              # Verify API is accessible
              echo "Checking API connectivity at $API_URL..."
              for i in {1..30}; do
                  if curl -fs "$API_URL/health" > /dev/null 2>&1; then
                      echo "✓ API service is reachable"
                      break
                  elif [ $i -eq 30 ]; then
                      echo "✗ API service not reachable after 30 attempts"
                      echo "Continuing anyway..."
                  else
                      echo "Waiting for API service... attempt $i/30"
                      sleep 5
                  fi
              done
              # Get API Service endpoint via internal DNS
              PD_ENDPOINTS="${TiKVPDEndpoints}"

              echo "Starting Coordinator Watcher..."
              echo "  TiKV PD: $PD_ENDPOINTS"
              echo "  Redis: ${RedisCoordinatorEndpoint}"
              echo "  API: $API_URL"
              
              # Start watcher
              exec /psy-node/psy_node_cli watcher \
                --node-type coordinator \
                --node-id 0 \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ config.nodes.coordinator.backend.tikv.namespace }}-coordinator" \
                --redis-uri "redis://${RedisCoordinatorEndpoint}:6379" \
                --api-endpoint "$API_URL"
  

  CoordinatorWatcherService:
    Type: AWS::ECS::Service
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-coordinator-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref CoordinatorWatcherTaskDefinition
      DesiredCount: 1 
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'

  {% for realm in config.nodes.realms %}
  # Realm {{ realm.id }} Watcher Service
  Realm{{ realm.id }}WatcherTaskDefinition:
    Type: AWS::ECS::TaskDefinition
    Properties:
      Family: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      NetworkMode: host
      RequiresCompatibilities:
        - EC2
      ExecutionRoleArn: !Ref TaskExecutionRoleArn
      TaskRoleArn: !Ref TaskRoleArn
      Volumes:
        - Name: config-volume
          Host:
            SourcePath: /psy-node/config.json
      ContainerDefinitions:
        - Name: realm-{{ realm.id }}-watcher
          Image: !Sub '${ECRRepositoryURI}:latest'
          Environment:
            - Name: AWS_DEFAULT_REGION
              Value: !Ref 'AWS::Region'
            - Name: ProjectName
              Value: !Ref ProjectName
            - Name: Environment
              Value: !Ref Environment
            - Name: TiKVPDEndpoints
              Value: !Ref TiKVPDEndpoints
            - Name: API_ENDPOINT
              Value: !Ref APIServiceEndpoint
            - Name: RedisRealm{{ realm.id }}Endpoint
              Value: !Ref RedisRealm{{ realm.id }}Endpoint
          Memory: 2048
          MemoryReservation: 1536
          Cpu: 2048
          LinuxParameters:
            InitProcessEnabled: true
          MountPoints:
            - SourceVolume: config-volume
              ContainerPath: /psy-node/config.json
              ReadOnly: true
          LogConfiguration:
            LogDriver: awslogs
            Options:
              awslogs-group: {{ config.nodes.deployment.aws.ecs.log_group }}
              awslogs-region: !Ref 'AWS::Region'
              awslogs-stream-prefix: realm-{{ realm.id }}-watcher
          Essential: true
          HealthCheck:
            Command:
              - CMD-SHELL
              - 'pgrep -f "psy_node_cli.*watcher.*--node-type realm" || exit 1'
            Interval: 30
            Timeout: 5
            Retries: 3
            StartPeriod: 60
          EntryPoint:
            - /bin/bash
            - -c
          Command:
            - !Sub |
              # Config is mounted
              if [ ! -f /psy-node/config.json ]; then
              echo "ERROR: config.json not found at /psy-node/config.json"
              exit 1
              fi

              PD_ENDPOINTS="${TiKVPDEndpoints}"
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"

              # API endpoint resolution
              if [ -n "${APIServiceEndpoint}" ]; then
                  API_URL="${APIServiceEndpoint}"
                  echo "Using provided APIServiceEndpoint: $API_URL"
              elif [ -n "${ALBDNSName}" ]; then
                  API_URL="http://${ALBDNSName}:3000"
                  echo "Using ALB DNS for API: $API_URL"
              else
                  API_URL="http://${APIServiceEndpoint}:3000"
                  echo "Using API Service Endpoint for API: $API_URL"
              fi

              # Verify API connectivity
              echo "Checking API connectivity at $API_URL..."
              for i in {1..30}; do
                  if curl -fs "$API_URL/health" > /dev/null 2>&1; then
                      echo "✓ API service is reachable"
                      break
                  elif [ $i -eq 30 ]; then
                      echo "✗ API service not reachable, continuing anyway..."
                  else
                      echo "Waiting for API... attempt $i/30"
                      sleep 5
                  fi
              done
              # Use the environment variable directly
              PD_ENDPOINTS="${TiKVPDEndpoints}"
              REDIS_ENDPOINT="${RedisRealm{{ realm.id }}Endpoint}"
              
              echo "Starting Realm {{ realm.id }} Watcher..."
              echo "  TiKV PD: $PD_ENDPOINTS"
              echo "  Redis: redis://$REDIS_ENDPOINT:6379"
              echo "  API: $API_URL"
              
              # Start watcher
              exec /psy-node/psy_node_cli watcher \
                --node-type realm \
                --node-id {{ realm.id }} \
                --database tikv \
                --tikv-pd-endpoints "$PD_ENDPOINTS" \
                --tikv-namespace "{{ realm.backend.tikv.namespace }}" \
                --redis-uri "redis://$REDIS_ENDPOINT:6379" \
                --api-endpoint "$API_URL"
      

  Realm{{ realm.id }}WatcherService:
    Type: AWS::ECS::Service
    DependsOn: 
      - Realm{{ realm.id }}ProcessorService
    Properties:
      ServiceName: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-watcher'
      Cluster: !Ref MainECSClusterName
      TaskDefinition: !Ref Realm{{ realm.id }}WatcherTaskDefinition
      DesiredCount: 1  # Single watcher per realm
      LaunchType: EC2
      PlacementConstraints:
        - Type: memberOf
          Expression: 'attribute:workload == general'
      PlacementStrategies:
        - Type: spread
          Field: attribute:ecs.availability-zone
  {% endfor %} 


Outputs:
  # Coordinator Service Outputs
  CoordinatorEdgeServiceName:
    Value: !Ref CoordinatorEdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-service'

  # Realm Service Outputs
  {% for realm in config.nodes.realms %}
  Realm{{ realm.id }}EdgeServiceName:
    Value: !Ref Realm{{ realm.id }}EdgeService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-realm-{{ realm.id }}-edge-service'
  {% endfor %}

  # Independent Worker Outputs
  {% if config.nodes.workers and config.nodes.workers.enabled %}
  WorkerServiceName:
    Value: !Ref WorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-worker-service'
    Description: Worker Service Name

  WorkerServiceArn:
    Value: !Ref WorkerService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-worker-service-arn'
    Description: Worker Service ARN
  {% endif %}


  # Service Discovery
  CoordinatorEdgeServiceDiscoveryArn:
    Value: !GetAtt CoordinatorEdgeServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-coordinator-edge-sd'


  {% if config.nodes.prover and config.nodes.prover.enabled %}
  ProverServiceName:
    Value: !Ref ProverService
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-service'

  ProverServiceDiscoveryArn:
    Value: !GetAtt ProverServiceDiscovery.Arn
    Export:
      Name: !Sub '${ProjectName}-${Environment}-prover-sd'
  {% endif %}

