# Function to upload and manage config in S3
manage_config() {
    local action=$1
    local config_bucket="${PROJECT_NAME}-${ENVIRONMENT}-config-$(aws sts get-caller-identity --query Account --output text)-${REGION}"
    local base_config_key="base/config.json"
    local service_configs_prefix="services/"
    
    case "$action" in
        upload-base)
            log_info "Uploading base config to S3..."
            aws s3 cp ../config.json "s3://${config_bucket}/${base_config_key}" \
                --content-type "application/json" \
                --metadata "timestamp=$(date -u +%Y%m%d%H%M%S)" \
                --region "${REGION}"
            ;;
            
        generate-service-configs)
            log_info "Generating service-specific configs..."
            
            # Get current infrastructure endpoints
            local alb_dns=$(aws cloudformation describe-stacks \
                --stack-name "${PROJECT_NAME}-main" \
                --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
                --output text \
                --region "${REGION}")
            
            # Download base config
            aws s3 cp "s3://${config_bucket}/${base_config_key}" /tmp/base_config.json
            
            # Generate coordinator config
            jq --arg alb "$alb_dns" \
                '.network.coordinator_configs[0].rpc_url = ["http://\($alb):8545"]' \
                /tmp/base_config.json > /tmp/coordinator_config.json
            
            aws s3 cp /tmp/coordinator_config.json \
                "s3://${config_bucket}/${service_configs_prefix}coordinator.json" \
                --content-type "application/json" \
                --region "${REGION}"
            
            # Generate realm configs
            for i in 0 1; do
                jq --arg alb "$alb_dns" --arg realm_id "$i" \
                    '.network.realm_configs[$realm_id | tonumber].rpc_url = ["http://\($alb):" + (8546 + ($realm_id | tonumber) | tostring)]' \
                    /tmp/base_config.json > "/tmp/realm${i}_config.json"
                
                aws s3 cp "/tmp/realm${i}_config.json" \
                    "s3://${config_bucket}/${service_configs_prefix}realm${i}.json" \
                    --content-type "application/json" \
                    --region "${REGION}"
            done
            
            # Generate worker config with all endpoints
            jq --arg alb "$alb_dns" '
                .network.coordinator_configs[0].rpc_url = ["http://\($alb):8545"] |
                .network.realm_configs[0].rpc_url = ["http://\($alb):8546"] |
                .network.realm_configs[1].rpc_url = ["http://\($alb):8547"]
            ' /tmp/base_config.json > /tmp/worker_config.json
            
            aws s3 cp /tmp/worker_config.json \
                "s3://${config_bucket}/${service_configs_prefix}worker.json" \
                --content-type "application/json" \
                --region "${REGION}"
            ;;
            
        get-url)
            local service=${2:-base}
            if [ "$service" = "base" ]; then
                echo "https://${config_bucket}.s3.${REGION}.amazonaws.com/${base_config_key}"
            else
                echo "https://${config_bucket}.s3.${REGION}.amazonaws.com/${service_configs_prefix}${service}.json"
            fi
            ;;
    esac
}

# Main deployment function
deploy() {
    log_info "Starting Psy Protocol deployment..."
    
    # ========================================
    # Phase 1: Build and Push Docker Image
    # ========================================
    if [ "$SKIP_BUILD" != true ]; then
        log_info "=== Phase 1: Building Docker Image ==="
        if ! build_and_push_image "$IMAGE_TAG"; then
            log_error "Failed to build and push Docker image"
            return 1
        fi
    else
        log_info "=== Phase 1: Skipping Docker build (--skip-build) ==="
    fi

    # ========================================
    # Phase 2: Deploy Infrastructure
    # ========================================
    log_info "=== Phase 2: Deploying Infrastructure ==="
    if ! deploy_infrastructure; then
        log_error "Infrastructure deployment failed"
        return 1
    fi
    
    # ========================================
    # Phase 3: Wait for Infrastructure & Get Endpoints
    # ========================================
    log_info "=== Phase 3: Waiting for Infrastructure to be Ready ==="
    local alb_dns=$(wait_for_alb_dns)
    if [ -z "$alb_dns" ]; then
        log_error "Failed to get ALB DNS"
        return 1
    fi
    log_info "ALB DNS obtained: $alb_dns"
    
    # ========================================
    # Phase 4: Setup Configuration Management
    # ========================================
    log_info "=== Phase 4: Setting up Configuration ==="
    log_info "Local config file: ${LOCAL_CONFIG_FILE}"
    if ! setup_config_management "$alb_dns"; then
        log_error "Failed to setup configuration"
        return 1
    fi
    
    # ========================================
    # Phase 5: Deploy ECS Services
    # ========================================
    log_info "=== Phase 5: Deploying ECS Services ==="
    if ! deploy_ecs_services; then
        log_error "Services deployment failed"
        return 1
    fi
    
    # ========================================
    # Phase 6: Verify Deployment
    # ========================================
    log_info "=== Phase 6: Verifying Deployment ==="
    verify_deployment
    
    log_info "=== Deployment Completed Successfully! ==="
    show_status
    print_deployment_info
}

# Upload original config file (with placeholder/localhost endpoints)
upload_original_config() {
    log_info "Uploading original config to S3..."
    
    # Ensure config bucket exists
    if ! ensure_config_bucket; then
        log_error "Failed to create config bucket"
        return 1
    fi
    
    # Check if local config exists
    if [ ! -f "$LOCAL_CONFIG_FILE" ]; then
        log_error "Local config file not found: $LOCAL_CONFIG_FILE"
        log_info "Please ensure ${LOCAL_CONFIG_FILE} exists"
        return 1
    fi
    
    # Validate it's valid JSON
    if ! jq empty "$LOCAL_CONFIG_FILE" 2>/dev/null; then
        log_error "Local config is not valid JSON"
        return 1
    fi
    
    log_info "Using local config: $LOCAL_CONFIG_FILE"
    
    # Upload ORIGINAL config as-is to S3
    if ! aws s3 cp "$LOCAL_CONFIG_FILE" \
        "s3://${CONFIG_BUCKET_NAME}/${S3_CONFIG_KEY}" \
        --content-type "application/json" \
        --metadata "version=original,timestamp=$(date -u +%Y%m%d%H%M%S)" \
        --region "${REGION}"; then
        log_error "Failed to upload original config to S3"
        return 1
