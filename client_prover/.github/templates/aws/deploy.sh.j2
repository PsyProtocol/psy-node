        {% set uses_scylla = true %}
      {% endif %}
    {% endfor %}
    {% if uses_scylla %}
    echo ""
    echo "# Access ScyllaDB (via ECS Exec):"
    echo "# First, find the container instance ID:"
    echo "aws ecs list-container-instances --cluster ${CLUSTER_NAME} --region ${REGION}"
    echo "# Then access the instance:"
    echo "aws ssm start-session --target <instance-id> --region ${REGION}"
    echo "# Inside the instance, access ScyllaDB containers:"
    echo "docker exec -it psy-scylla-coordinator-1 cqlsh"
    {% endif %}
    
    echo ""
    echo "# View all ECS services:"
    echo "aws ecs list-services --cluster ${CLUSTER_NAME} --region ${REGION}"
    
    echo ""
    echo "# Tail all logs in log group:"
    echo "aws logs tail {{ config.nodes.deployment.aws.ecs.log_group }} --follow --region ${REGION}"
    
    echo -e "\n${GREEN}Deployment complete!${NC}"
}

# Main destroy function
destroy() {
    if [ "$FORCE" != true ]; then
        log_warning "This will destroy all infrastructure for ${PROJECT_NAME}"
        read -p "Are you sure? (yes/no): " -r
        if [[ ! $REPLY =~ ^[Yy][Ee][Ss]$ ]]; then
            log_info "Destruction cancelled"
            return 0
        fi
    fi
    
    log_warning "Destroying all stacks..."
    
    # IMPORTANT: Clean up S3 buckets BEFORE deleting stacks
    cleanup_s3_buckets

    # Delete services stack first
    delete_stack "${PROJECT_NAME}-services"
    
    # Delete main stack
    delete_stack "${PROJECT_NAME}-main"
    
    # Cleanup orphaned resources
    cleanup_ebs_volumes
    cleanup_ecr_images
    
    log_info "Destruction completed"
}

# Main cleanup function
cleanup() {
    log_info "Running comprehensive cleanup..."
    
    force_cleanup_ecs
    force_cleanup_asg
    cleanup_elasticache
    cleanup_ebs_volumes
    cleanup_ecr_images
    
    log_info "Cleanup completed"
}

# Parse command line arguments
COMMAND=""
FORCE=false
SKIP_BUILD=false
IMAGE_TAG="latest"
VERBOSE=false
DRY_RUN=false
ENVIRONMENT="dev"

while [[ $# -gt 0 ]]; do
    case $1 in
        deploy|update|update-instances|destroy|cleanup|status|build|update-services|monitor|logs|validate-template|validate)
            COMMAND=$1
            shift
            ;;
        --force|-f)
            FORCE=true
            shift
            ;;
        --skip-build)
            SKIP_BUILD=true
            shift
            ;;
        --tag)
            IMAGE_TAG="$2"
            shift 2
            ;;
        --profile)
            export AWS_PROFILE="$2"
            shift 2
            ;;
        --verbose|-v)
            VERBOSE=true
            set -x
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --env|--environment)
            ENVIRONMENT="$2"
            shift 2
            ;;
        --help|-h)
            show_help
            exit 0
            ;;
        *)
            if [ -z "$COMMAND" ] && [ "$1" = "logs" ]; then
                COMMAND="logs"
            else
                SERVICE_NAME="$1"
            fi
            shift
            ;;
    esac
done

# Check prerequisites
check_aws_cli

# Execute command
case "$COMMAND" in
    deploy)
        deploy
        ;;
    destroy)
        destroy
        ;;
    cleanup)
        cleanup
        ;;
    status)
        show_status
        ;;
    build)
        build_and_push_image "$IMAGE_TAG"
        ;;
    update-services)
        SKIP_BUILD=true
        deploy_ecs_services
        # Then force services to redeploy regardless
        force_service_redeploy
        ;;
    monitor)
        if check_stack_exists "${PROJECT_NAME}-main"; then
            monitor_stack_progress "${PROJECT_NAME}-main" "Stack operation"
        elif check_stack_exists "${PROJECT_NAME}-services"; then
            monitor_stack_progress "${PROJECT_NAME}-services" "Stack operation"
        else
            log_error "No active stacks found"
        fi
        ;;
    update)
        update
        ;;
    update-instances)
        force_update_instances
        ;;
    validate-template|validate)
        validate_template "$SERVICE_NAME"  # Optional template path
        ;;
    {# health|check-health)
        check_instance_health
        ;; #}
    logs)
        show_logs "$SERVICE_NAME"
        ;;
    *)
        log_error "Unknown command: $COMMAND"
        show_help
        exit 1
        ;;
esac
