    else
        log_error "Failed to verify config upload"
        return 1
    fi
    
    return 0
}

# Update config with real endpoints AFTER infrastructure is deployed
update_config_with_endpoints() {
    local alb_dns=$1
    
    # Clean the ALB DNS
    alb_dns=$(echo "$alb_dns" | tr -d '[:space:]')
    
    log_info "Updating config with real endpoints..."
    log_info "Using ALB DNS: $alb_dns"
    
    # Validate DNS
    if [[ ! "$alb_dns" =~ ^[a-zA-Z0-9.-]+$ ]]; then
        log_error "Invalid ALB DNS: '$alb_dns'"
        return 1
    fi
    
    # Download current config from S3
    if ! aws s3 cp "s3://${CONFIG_BUCKET_NAME}/${S3_CONFIG_KEY}" \
        /tmp/config-current.json \
        --region "${REGION}"; then
        log_error "Failed to download current config from S3"
        return 1
    fi
    
    # Generate URLs
    local coord_url="http://${alb_dns}:8545"
    local realm0_url="http://${alb_dns}:8546"
    local realm1_url="http://${alb_dns}:8547"
    
    log_info "Updating URLs:"
    log_info "  Coordinator: $coord_url"
    log_info "  Realm 0: $realm0_url"
    log_info "  Realm 1: $realm1_url"
    
    # Update the config with real endpoints
    jq \
        --arg coord_url "$coord_url" \
        --arg realm0_url "$realm0_url" \
        --arg realm1_url "$realm1_url" \
        '.network.coordinator_configs[0].rpc_url = [$coord_url] | 
         .network.realm_configs[0].rpc_url = [$realm0_url] | 
         .network.realm_configs[1].rpc_url = [$realm1_url]' \
        /tmp/config-current.json > /tmp/config-updated.json
    
    # Verify jq succeeded
    if [ $? -ne 0 ] || [ ! -s /tmp/config-updated.json ]; then
        log_error "Failed to update config with jq"
        return 1
    fi
    
    # Validate updated config is valid JSON
    if ! jq empty /tmp/config-updated.json 2>/dev/null; then
        log_error "Updated config is not valid JSON"
        cat /tmp/config-updated.json
        return 1
    fi
    
    # Verify URLs were actually updated
    local verify_coord=$(jq -r '.network.coordinator_configs[0].rpc_url[0] // empty' /tmp/config-updated.json)
    if [[ ! "$verify_coord" =~ ^http://${alb_dns} ]]; then
        log_error "Config update verification failed"
        log_error "Expected: http://${alb_dns}:8545"
        log_error "Got: $verify_coord"
        return 1
    fi
    
    # Upload updated config back to S3 (OVERWRITE)
    log_info "Uploading updated config to S3..."
    if ! aws s3 cp /tmp/config-updated.json \
        "s3://${CONFIG_BUCKET_NAME}/${S3_CONFIG_KEY}" \
        --content-type "application/json" \
        --metadata "version=updated,timestamp=$(date -u +%Y%m%d%H%M%S),alb=${alb_dns}" \
        --region "${REGION}"; then
        log_error "Failed to upload updated config to S3"
        return 1
    fi
    
    log_info "✓ Config updated with real endpoints"
    
    # Clean up temp files
    rm -f /tmp/config-current.json /tmp/config-updated.json
    
    return 0
}

# Helper function to wait for ALB DNS
wait_for_alb_dns() {
    local max_attempts=30
    local attempt=0
    local alb_dns=""
    
    while [ -z "$alb_dns" ] && [ $attempt -lt $max_attempts ]; do
        alb_dns=$(aws cloudformation describe-stacks \
            --stack-name "${PROJECT_NAME}-main" \
            --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
            --output text \
            --region "${REGION}" 2>/dev/null)
        
        if [ -z "$alb_dns" ]; then
            echo -ne "\rWaiting for ALB DNS... attempt $((attempt+1))/$max_attempts"
            sleep 5
            attempt=$((attempt+1))
        fi
    done
    echo ""
    
    echo "$alb_dns"
}

# Centralized config management setup
setup_config_management() {
    local alb_dns=$1
    
    # Clean the ALB DNS - remove any whitespace/newlines
    alb_dns=$(echo "$alb_dns" | tr -d '[:space:]')

    log_info "Using ALB DNS: $alb_dns"

    # Validate the cleaned DNS
    if [[ ! "$alb_dns" =~ ^[a-zA-Z0-9.-]+$ ]]; then
        log_error "Invalid ALB DNS after cleaning: '$alb_dns'"
        return 1
    fi
    log_info "Using cleaned ALB DNS: $alb_dns"

    # Ensure config bucket exists
    if ! ensure_config_bucket; then
        log_error "Failed to create config bucket"
        return 1
    fi

    # Check if local config exists
    if [ ! -f "$LOCAL_CONFIG_FILE" ]; then
        log_error "Local config file not found: $LOCAL_CONFIG_FILE"
        log_info "Please ensure ${LOCAL_CONFIG_FILE} exists in the project root"
        return 1
    fi

    log_info "Using local config: $LOCAL_CONFIG_FILE"

    
    # Generate config with actual endpoints
    log_info "Generating config with actual endpoints..."
    local coord_url="http://${alb_dns}:8545"
    local realm0_url="http://${alb_dns}:8546"
    local realm1_url="http://${alb_dns}:8547"

    jq \
        --arg coord_url "$coord_url" \
        --arg realm0_url "$realm0_url" \
        --arg realm1_url "$realm1_url" \
        '.network.coordinator_configs[0].rpc_url = [$coord_url] | 
         .network.realm_configs[0].rpc_url = [$realm0_url] | 
         .network.realm_configs[1].rpc_url = [$realm1_url]' \
        "$LOCAL_CONFIG_FILE" > /tmp/deploy.json
   
    # Check if jq succeeded
    if [ $? -ne 0 ]; then
        log_error "jq command failed"
        return 1
    fi
   
    # Verify the file was created and is valid JSON
    if [ ! -s /tmp/deploy.json ]; then
        log_error "Generated config file is empty"
        return 1
    fi

    if ! jq empty /tmp/deploy.json 2>/dev/null; then
        log_error "Generated config is not valid JSON"
        cat /tmp/deploy.json
        return 1
    fi

    # Extract and verify URLs
    log_info "Verifying generated URLs..."
    local verify_coord=$(jq -r '.network.coordinator_configs[0].rpc_url[0] // empty' /tmp/deploy.json)
    local verify_realm0=$(jq -r '.network.realm_configs[0].rpc_url[0] // empty' /tmp/deploy.json)
    local verify_realm1=$(jq -r '.network.realm_configs[1].rpc_url[0] // empty' /tmp/deploy.json)
    
    # Check if extraction succeeded
    if [ -z "$verify_coord" ] || [ -z "$verify_realm0" ] || [ -z "$verify_realm1" ]; then
        log_error "Failed to extract URLs from generated config"
        echo "Config structure:"
        jq '.network' /tmp/deploy.json
        return 1
    fi
    
    # Simple validation - just check they start with http://
    if [[ ! "$verify_coord" =~ ^http:// ]]; then
        log_error "Coordinator URL invalid: $verify_coord"
        return 1
    fi
    
    if [[ ! "$verify_realm0" =~ ^http:// ]]; then
        log_error "Realm 0 URL invalid: $verify_realm0"
        return 1
    fi
    
    if [[ ! "$verify_realm1" =~ ^http:// ]]; then
        log_error "Realm 1 URL invalid: $verify_realm1"
        return 1
    fi

    # Upload as config.json to S3 (single source of truth)
    log_info "Uploading config to S3 as ${S3_CONFIG_KEY}..."
    if ! aws s3 cp /tmp/deploy.json \
        "s3://${CONFIG_BUCKET_NAME}/${S3_CONFIG_KEY}" \
        --content-type "application/json" \
        --metadata "source=${LOCAL_CONFIG_FILE},timestamp=$(date -u +%Y%m%d%H%M%S)" \
        --region "${REGION}"; then
        log_error "Failed to upload config to S3"
        return 1
    fi 

    # Verify upload
    if aws s3 ls "s3://${CONFIG_BUCKET_NAME}/${S3_CONFIG_KEY}" --region "${REGION}" >/dev/null 2>&1; then
        log_info "Configuration uploaded successfully"
        echo "  Config URL: https://${CONFIG_BUCKET_NAME}.s3.${REGION}.amazonaws.com/${S3_CONFIG_KEY}"
    else
        log_error "Failed to verify config upload"
        return 1
    fi

    # Clean up temp file
    rm -f /tmp/deploy.json
    
    return 0
}

# Ensure config S3 bucket exists
ensure_config_bucket() {

    # Check if bucket exists
    if aws s3 ls "s3://${CONFIG_BUCKET_NAME}" --region "${REGION}" >/dev/null 2>&1; then
        log_info "Config bucket already exists: ${CONFIG_BUCKET_NAME}"
        return 0
    fi

    log_info "Creating config bucket: ${CONFIG_BUCKET_NAME}"

    if [ "${REGION}" = "us-east-1" ]; then
        aws s3api create-bucket \
            --bucket "${CONFIG_BUCKET_NAME}" \
            --region "${REGION}"
    else
        aws s3api create-bucket \
            --bucket "${CONFIG_BUCKET_NAME}" \
            --region "${REGION}" \
            --create-bucket-configuration LocationConstraint="${REGION}"
    fi
    
    
    # Enable versioning for config history
    aws s3api put-bucket-versioning \
        --bucket "${CONFIG_BUCKET_NAME}" \
        --versioning-configuration Status=Enabled \
        --region "${REGION}"
    
    # Set public read policy for easy access by services
    aws s3api put-bucket-policy \
        --bucket "${CONFIG_BUCKET_NAME}" \
        --policy '{
            "Version": "2012-10-17",
            "Statement": [
                {
                    "Sid": "PublicReadGetObject",
                    "Effect": "Allow",
                    "Principal": "*",
                    "Action": "s3:GetObject",
                    "Resource": "arn:aws:s3:::'"${CONFIG_BUCKET_NAME}"'/*"
                }
            ]
        }' \
        --region "${REGION}"
    
    return 0
}


# Verify deployment is working
verify_deployment() {
    log_info "Verifying services are running..."
    
    # Get cluster name
    local cluster_name=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='MainECSClusterName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$cluster_name" ]; then
        cluster_name="${PROJECT_NAME}-${ENVIRONMENT}-main-ecs"
    fi
    
    # Check ECS services
    local services=$(aws ecs list-services \
        --cluster "$cluster_name" \
        --query "serviceArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$services" ]; then
        log_info "ECS Services deployed:"
        for service_arn in $services; do
            local service_name=$(echo "$service_arn" | awk -F'/' '{print $NF}')
            local status=$(aws ecs describe-services \
                --cluster "$cluster_name" \
                --services "$service_arn" \
                --query "services[0].status" \
                --output text \
                --region "${REGION}" 2>/dev/null)
            echo "  - $service_name: $status"
        done
    fi
    
    # Test endpoints (optional)
    local alb_dns=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -n "$alb_dns" ]; then
        log_info "Testing endpoints..."
        for port in 8545 8546 8547; do
            if curl -s -f -m 5 "http://${alb_dns}:${port}/health" >/dev/null 2>&1; then
                echo "  ✓ Port $port is responding"
            else
                echo "  ⚠ Port $port not responding yet (may still be starting)"
            fi
        done
    fi
}

# Simplified update-services function
update_services() {
    log_info "Updating ECS services with new configuration..."
    
    # Get ALB DNS
    local alb_dns=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='ALBDNSName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$alb_dns" ]; then
        log_error "Could not get ALB DNS. Is infrastructure deployed?"
        return 1
    fi
    
    # Update single config file
    log_info "Updating config.json in S3..."
    setup_config_management "$alb_dns"

    
    # Force ECS services to pull new config
    local cluster_name="${PROJECT_NAME}-${ENVIRONMENT}-main-ecs"
    local services=$(aws ecs list-services \
        --cluster "$cluster_name" \
        --query "serviceArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$services" ]; then
        log_warning "No ECS services found in cluster: $cluster_name"
        return 0
    fi

    for service_arn in $services; do
        local service_name=$(basename "$service_arn")
        log_info "Forcing new deployment for: $service_name"
        aws ecs update-service \
            --cluster "$cluster_name" \
            --service "$service_arn" \
            --force-new-deployment \
            --region "${REGION}" >/dev/null
    done
    
    log_info "Services updated. They will restart and fetch new configs."
}
# Force ECS services to redeploy with new configuration
force_service_redeploy() {
    log_info "Forcing ECS services to redeploy..."
    
    # Get cluster name from CloudFormation outputs
    local cluster_name=$(aws cloudformation describe-stacks \
        --stack-name "${PROJECT_NAME}-main" \
        --query "Stacks[0].Outputs[?OutputKey=='MainECSClusterName'].OutputValue" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$cluster_name" ]; then
        log_error "Could not find ECS cluster name"
        return 1
    fi
    
    # Get all services in the cluster
    local services=$(aws ecs list-services \
        --cluster "$cluster_name" \
        --query "serviceArns[]" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    if [ -z "$services" ]; then
        log_warning "No ECS services found in cluster: $cluster_name"
        return 0
    fi
    
    # Force new deployment for each service
    for service_arn in $services; do
        local service_name=$(basename "$service_arn")
        log_info "Forcing new deployment for: $service_name"
        
        aws ecs update-service \
            --cluster "$cluster_name" \
            --service "$service_arn" \
            --force-new-deployment \
            --region "${REGION}" >/dev/null 2>&1
        
        if [ $? -eq 0 ]; then
            echo "  ✓ Triggered redeployment for $service_name"
        else
            echo "  ✗ Failed to trigger redeployment for $service_name"
        fi
    done
    
    log_info "All services have been triggered for redeployment"
    log_info "Services will pull the latest config from S3 on restart"
}
cleanup_s3_buckets() {
    log_info "Cleaning up S3 buckets..."
    
    local buckets=$(aws s3api list-buckets \
        --query "Buckets[?contains(Name, '${PROJECT_NAME}')].Name" \
        --output text \
        --region "${REGION}" 2>/dev/null)
    
    for bucket in $buckets; do
        log_info "Processing bucket: $bucket"
        
        if aws s3api head-bucket --bucket "$bucket" 2>/dev/null; then
            # Empty bucket
            log_info "Emptying bucket: $bucket"
            aws s3 rm "s3://${bucket}" --recursive --region "${REGION}" >/dev/null 2>&1 || true
            
            # Delete versions - ADD OUTPUT REDIRECTION
            log_info "Deleting object versions in bucket: $bucket"
            local versions=$(aws s3api list-object-versions \
                --bucket "$bucket" \
                --output json \
                --query '{Objects: Versions[].{Key:Key,VersionId:VersionId}}' \
                --region "${REGION}" 2>/dev/null)
            
            if [ "$versions" != "null" ] && [ -n "$versions" ]; then
                echo "$versions" | jq -c 'select(.Objects != null)' | \
                    xargs -I {} aws s3api delete-objects \
                        --bucket "$bucket" \
                        --delete '{}' \
                        --region "${REGION}" \
                        --output text >/dev/null 2>&1 || true  # Redirect output
            fi
            
            # Delete delete markers - ADD OUTPUT REDIRECTION
            local markers=$(aws s3api list-object-versions \
                --bucket "$bucket" \
                --output json \
                --query '{Objects: DeleteMarkers[].{Key:Key,VersionId:VersionId}}' \
                --region "${REGION}" 2>/dev/null)
            
            if [ "$markers" != "null" ] && [ -n "$markers" ]; then
                echo "$markers" | jq -c 'select(.Objects != null)' | \
                    xargs -I {} aws s3api delete-objects \
                        --bucket "$bucket" \
                        --delete '{}' \
                        --region "${REGION}" \
                        --output text >/dev/null 2>&1 || true  # Redirect output
            fi
        fi
    done
    
    log_info "S3 cleanup completed"
}
