    echo "$0 logs realm-{{ realm.id }}-edge"
    echo "$0 logs realm-{{ realm.id }}-worker"
    {% endfor %}
    echo "$0 logs prover"
    
    echo ""
    echo "# Monitor deployment status:"
    echo "$0 status"
    
    echo ""
    echo "# Update services after code changes:"
    echo "$0 build && $0 update-services"
    
    {% set uses_scylla = false %}
    {% if config.nodes.coordinator.backend.type == "scylla" %}
      {% set uses_scylla = true %}
    {% endif %}
    {% for realm in config.nodes.realms %}
